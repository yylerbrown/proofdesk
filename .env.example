# Runtime environment: development, test or production.
NODE_ENV=development
# Port the HTTP server listens on.
PORT=3000
# Path of the SQLite database file. The directory is created if missing.
DATABASE_PATH=./data/app.db
# Optional. Git commit hash reported by the health route (set at build or deploy time).
GIT_COMMIT=
# Prefix of public ticket keys such as SUP-42. 2 to 6 capital letters.
TICKET_PREFIX=SUP
# Development only: on lets anyone pick who they are on the sign-in page, with no keys.
# The server refuses to start with this on when NODE_ENV is production. On by default here,
# so a fresh copy can be tried at once; turn it off when you set up GitHub sign-in.
DEV_SIGN_IN=on

# GitHub sign-in. Set all four or none. Required when NODE_ENV is production.
# A random secret of at least 32 characters, for example from: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address people open in the browser, for example http://localhost:3000
BETTER_AUTH_URL=
# From the GitHub OAuth app. Its callback address is <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub user numbers, separated by commas. Everyone else who signs in is a customer.
# The number of an account is the "id" shown at https://api.github.com/users/<user name>
TEAM_GITHUB_IDS=
ADMIN_GITHUB_IDS=

# Behind a host's proxy: the header that holds the visitor's real address, used for rate
# limits. Fly.io sets fly-client-ip. Leave empty when running on your own machine.
# CLIENT_IP_HEADER=

# The public demo: on makes this server the demo, with sample data and made-up people. It
# refuses to start together with the GitHub sign-in settings. Run it as its own server
# with its own database.
DEMO=off

# Optional, on a server that is not the demo: the demo's https address, linked from the
# sign-in page as "Try the demo without signing in".
DEMO_URL=

# Optional, on the demo: the real site's https address, named as where GitHub sign-in with
# roles runs.
REAL_SITE_URL=

# Optional: the repository's https address. The welcome page then links "Source and setup" to its
# README.
SOURCE_URL=

# Optional: the address people and assistants reach this server at, for the commands it gives
# to paste. Without it they use BETTER_AUTH_URL, or else the address each request came to. Set
# it behind a proxy that ends HTTPS when BETTER_AUTH_URL is not set, as on the demo.
PUBLIC_URL=

# Optional: email notices. Set both or neither. Without them, or on the demo, notices are kept
# as not sent and nothing is emailed. SMTP_URL is the mail server, for example
# smtps://user:password@smtp.example.com:465 (smtp:// on port 587 upgrades to TLS). It holds a
# password, so keep it in the host's secrets, never in a file you commit. MAIL_FROM is the
# address notices come from, on a domain the mail provider lets you send from.
SMTP_URL=
MAIL_FROM=
