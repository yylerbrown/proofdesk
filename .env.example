# Runtime environment: development, test or production.
NODE_ENV=development
# Port the HTTP server listens on.
PORT=3000
# Path of the SQLite database file. The directory is created if missing.
DATABASE_PATH=./data/app.db
# Optional. Git commit hash reported by the health route (set at build or deploy time).
GIT_COMMIT=
# Prefix of public ticket keys such as SUP-42. 2 to 6 capital letters.
TICKET_PREFIX=SUP
# Development only: on lets anyone pick who they are on the sign-in page, with no keys.
# The server refuses to start with this on when NODE_ENV is production.
DEV_SIGN_IN=off
