{
  "name": "proofdesk",
  "version": "0.1.0",
  "scripts": {
    "predev": "npm run build:browser",
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:browser",
    "build:browser": "tsc -p tsconfig.browser.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "description": "A customer support ticketing system.",
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@picocss/pico": "2.1.1",
    "better-auth": "^1.7.25",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "10.3.1",
    "zod": "^4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "node-html-parser": "9.0.6",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  }
}
