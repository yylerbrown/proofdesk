<%- include("header") %>
<div class="column">
<h1>Archive <%= ticket.key %>?</h1>
<p><strong><%= ticket.title %></strong></p>

<% if (canSeeArchived) { %>
<p>The ticket will leave the lists. Nothing is deleted. You can find it under Archived and restore it.</p>
<% } else { %>
<p class="archive-why">Filed by mistake, or twice? Archiving takes this ticket off your list and the team's.</p>
<p>You will not be able to open it again. Nothing is deleted, and the support team can restore it if you ask.</p>
<% } %>

<form method="post" action="/tickets/<%= ticket.key %>/archive">
  <div class="choice">
    <a href="/tickets/<%= ticket.key %>" role="button" class="secondary outline">Keep ticket</a>
    <button type="submit" class="danger">Archive ticket</button>
  </div>
</form>
</div>
<%- include("footer") %>
