<%- include("header") %>
<h1>Archive <%= ticket.key %>?</h1>
<p><strong><%= ticket.title %></strong></p>

<% if (canSeeArchived) { %>
<p>The ticket will leave the lists. Nothing is deleted. You can find it under Archived and restore it.</p>
<% } else { %>
<p>The ticket will leave your list and you will not be able to open it again. Nothing is deleted, and the support team can restore it if you ask.</p>
<% } %>

<form method="post" action="/tickets/<%= ticket.key %>/archive">
  <div class="choice">
    <a href="/tickets/<%= ticket.key %>" role="button" class="secondary outline compact">Keep ticket</a>
    <button type="submit" class="danger compact">Archive ticket</button>
  </div>
</form>
<%- include("footer") %>
