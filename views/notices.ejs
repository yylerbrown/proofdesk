<%- include("header") %>
<div class="column notices">
<%# The ticket pages' way back, one step further: the list, the ticket, then this page. %>
<p class="back"><a href="/tickets"><%= forTeam ? "All tickets" : "My tickets" %></a> / <a href="/tickets/<%= ticket.key %>"><%= ticket.key %></a> / Emails</p>
<h1>Emails sent about this ticket</h1>
<p><strong class="user-text"><%= ticket.title %></strong></p>
<p class="notices-lead"><%= forTeam ? "What this ticket emailed its customer and owner, newest first." : "What this ticket emailed you, newest first." %></p>

<% if (notices.length === 0) { %>
<p>No emails sent yet.</p>
<% } %>
<%# Each email reads like one: who it went to and when, its subject in bold, then its words. %>
<% for (const notice of notices) { %>
<article class="email">
  <header>
    <span class="email-to">To <strong><%= notice.to %></strong></span>
    <span class="email-when"><small class="email-state"><%= notice.state %></small> <small><%- include("time", { iso: notice.when }) %></small></span>
  </header>
  <p class="email-subject"><%= notice.subject %></p>
  <%# The body keeps its line breaks. Only the address of this ticket becomes a link. -%>
  <p class="email-body"><% for (const part of notice.bodyParts) { %><% if (part.href) { %><a href="<%= part.href %>"><%= part.text %></a><% } else { %><%= part.text %><% } %><% } %></p>
</article>
<% } %>
</div>
<%- include("footer") %>
