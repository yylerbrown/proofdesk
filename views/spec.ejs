<%# The ticket's test spec: proposed, usually by someone's own AI assistant, and a suggestion until a person on the team accepts it. Shown collapsed, with a native details element, so no script is needed. %>
<% const spec = specPanel.spec; %>
<% if (spec) { %>
<section class="spec" aria-labelledby="spec-heading">
  <h2 id="spec-heading"><%= spec.state === "accepted" ? "Agreed way to test" : "Suggested test spec" %></h2>
  <details>
    <summary>
      <span class="user-text"><%= spec.summary %></span>
      <br /><small><%= spec.coverage.scenarios %> <%= spec.coverage.scenarios === 1 ? "scenario" : "scenarios" %>. Proposed by <%= spec.proposed_by.name %><% if (spec.proposed_by.kind === "agent") { %> (AI agent)<% } %> (reported, not verified)<% if (spec.state === "accepted") { %>. Accepted by <%= spec.decided_by_name %><% } %>.</small>
    </summary>
    <ol class="scenarios">
      <% for (const scenario of spec.scenarios) { %>
      <li>
        <p><strong class="user-text"><%= scenario.title %></strong></p>
        <p class="user-text">Given <%= scenario.given %></p>
        <p class="user-text">When <%= scenario.when %></p>
        <p class="user-text">Then <%= scenario.then %></p>
        <% if (scenario.test_name) { %><p><small>Test: <code class="user-text"><%= scenario.test_name %></code></small></p><% } %>
        <p><small><%= scenario.has_evidence ? "Evidence names this scenario." : "No evidence names this scenario yet." %></small></p>
      </li>
      <% } %>
    </ol>
  </details>
  <% if (specPanel.canDecide && spec.state === "proposed") { %>
  <div role="group">
    <form method="post" action="/tickets/<%= specPanel.key %>/spec/decision">
      <input type="hidden" name="decision" value="accept" />
      <button type="submit" class="compact">Accept as the way to test</button>
    </form>
    <form method="post" action="/tickets/<%= specPanel.key %>/spec/decision">
      <input type="hidden" name="decision" value="discard" />
      <button type="submit" class="compact secondary">Discard</button>
    </form>
  </div>
  <% } %>
</section>
<% } else if (specPanel.offerPrompt) { %>
<div class="spec-prompt">
  <p><small>Want better results? Ask your assistant to spec this ticket. <a href="<%= specPanel.connectUrl %>">Connect your assistant</a></small></p>
  <% const specPrompt = `Using Proofdesk, write a test spec for ${specPanel.key}`; %>
  <pre class="paste"><code><%= specPrompt %></code></pre>
  <button type="button" class="copy secondary" data-copy="<%= specPrompt %>" hidden>Copy</button>
</div>
<% } %>
