<%# One thing to try as each kind of person, shown under their name wherever people are offered: the development entrance and the demo's page a ticket link opens. -%>
<%
  const tries = {
    customer: "File a ticket, then follow it until the team marks it fixed.",
    team: "Take a ticket, write an internal note, and mark it fixed.",
    admin: person.demo
      ? "See every ticket and its full history, and change nothing."
      : "See every ticket, restore archived ones, and delete one permanently.",
  };
%><%= tries[person.role] %>