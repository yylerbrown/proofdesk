<%- include("header") %>
<div class="column account">
<h1>Your account</h1>
<%# One quiet card: a small grey label and its value on each row, and the email switch last. %>
<dl class="account-card">
  <div class="account-row">
    <dt>Name</dt>
    <dd class="user-text account-name"><%= viewer.readOnly === true ? `${name} (read-only)` : name %></dd>
  </div>
  <div class="account-row">
    <dt>Email</dt>
    <% if (email) { %>
    <dd class="user-text account-email"><%= email %></dd>
    <% } else { %>
    <dd class="account-email account-quiet"><%= madeUpLine %></dd>
    <% } %>
  </div>
  <div class="account-row">
    <dt>Role</dt>
    <dd class="account-role"><%= roleWord %></dd>
  </div>
  <div class="account-row">
    <dt>Email notices</dt>
    <dd>
      <form method="post" action="/account" class="email-me">
        <fieldset <% if (!canChangeEmailMe) { %>disabled<% } %>>
          <label><input type="checkbox" role="switch" name="email_me" <% if (emailMe) { %>checked<% } %> /> Email me about my tickets</label>
        </fieldset>
        <% if (mailLine) { %><small class="mail-line account-quiet"><%= mailLine %></small><% } %>
        <% if (canChangeEmailMe) { %><button type="submit">Save</button><% } %>
      </form>
    </dd>
  </div>
</dl>
</div>
<%- include("footer") %>
