<%- include("header") %>
<div class="column account">
<h1>Your account</h1>
<%# One quiet card: a small grey label and its value on each row, and the email switch last. %>
<dl class="account-card">
  <div class="account-row">
    <dt>Name</dt>
    <dd class="user-text account-name"><%= viewer.readOnly === true ? `${name} (read-only)` : name %></dd>
  </div>
  <div class="account-row">
    <dt>Email</dt>
    <% if (email) { %>
    <dd class="user-text account-email"><%= email %></dd>
    <% } else { %>
    <dd class="account-email account-quiet"><%= madeUpLine %></dd>
    <% } %>
  </div>
  <div class="account-row">
    <dt>Role</dt>
    <dd><span class="account-role"><%= roleWord %></span> <small class="roles-link account-quiet"><a href="/roles">Who may do what</a></small><br /><small class="role-allows account-quiet"><%= roleAllows %></small></dd>
  </div>
  <div class="account-row">
    <dt>Email notices</dt>
    <dd>
      <% if (canChangeEmailMe) { %>
      <form method="post" action="/account" class="email-me">
        <fieldset>
          <label><input type="checkbox" role="switch" name="email_me" <% if (emailMe) { %>checked<% } %> /> Email me about my tickets</label>
        </fieldset>
        <% if (mailLine) { %><small class="mail-line account-quiet"><%= mailLine %></small><% } %>
        <button type="submit">Save</button>
      </form>
      <% } else { %>
      <%# Where it cannot be changed, the setting is words, not a switch. The demo sends no
          email at all, so there it says only that. %>
      <% if (viewer.demo) { %>
      <p class="email-me email-me-fixed"><span class="email-me-state">Off on this demo</span></p>
      <% } else { %>
      <p class="email-me email-me-fixed"><span class="email-me-state"><%= emailMe ? "On" : "Off" %></span><% if (mailLine) { %> <small class="mail-line account-quiet"><%= mailLine %></small><% } %></p>
      <% } %>
      <% } %>
    </dd>
  </div>
</dl>
</div>
<%- include("footer") %>
