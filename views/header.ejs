<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title><%= title %> - Proofdesk</title>
    <link rel="icon" href="/assets/brand.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/pico.min.css" />
    <link rel="stylesheet" href="/assets/theme.css" />
    <link rel="stylesheet" href="/assets/site.css" />
  </head>
  <body>
    <%# The first stop on every page: keyboard users can jump past the header's links. %>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <% if (demo) { %>
      <p class="demo-strip">Demo: sample data, shared with every visitor.</p>
      <% } %>
      <%# Two groups and nothing else. Left: the brand and Tickets. Right: New ticket and one menu named
          for the person, which holds everything about them. %>
      <nav class="container">
        <ul class="links">
          <li><a href="/tickets" class="brand"><img src="/assets/brand.svg" alt="" width="24" height="24" /><strong>Proofdesk</strong></a></li>
          <% if (viewer) { %><li class="tickets-link"><a href="/tickets">Tickets</a></li><% } %>
        </ul>
        <% if (viewer) { %>
        <ul class="account">
          <%# Outlined, since a page's one black button is its own next step. The read-only admin
              preview cannot file a ticket, and the new ticket form is that page already, so
              neither shows it. %>
          <%# On a phone it reads "New", so the person's name fits; its name stays "New ticket". %>
          <% if (!viewer.readOnly && !locals.onNewTicketForm) { %><li><a href="/tickets/new" role="button" class="outline new-ticket">New<span class="new-ticket-rest"> ticket</span></a></li><% } %>
          <li class="viewer">
            <%# A native details element, so it opens and closes with scripts off. menus.js adds Escape and closing when focus leaves. %>
            <%# A demo name already says the role, so only a real name has its role word after it. %>
            <details class="dropdown person-menu">
              <summary><strong><%- include("demo-name", { person: viewer }) %></strong><% if (!viewer.demo && viewerRoleWord !== viewer.name) { %> <small class="role-label"><%= viewerRoleWord %></small><% } %></summary>
              <ul>
                <% if (viewer.demo && demoPeople.length > 0) { %>
                <%# The three made-up people by name. The current one is named, not offered. %>
                <li class="menu-heading">Switch role</li>
                <% for (const person of demoPeople) { %>
                <li class="role">
                  <% if (person.id === viewer.id) { %>
                  <span class="role-current" aria-current="true"><%- include("demo-name", { person }) %> (you)</span>
                  <% } else { %>
                  <form method="post" action="/sign-in/dev">
                    <input type="hidden" name="id" value="<%= person.id %>" />
                    <input type="hidden" name="next" value="<%= here %>" />
                    <button type="submit" class="link"><%- include("demo-name", { person }) %></button>
                  </form>
                  <% } %>
                  <small class="role-try"><%- include("role-try", { person }) %></small>
                </li>
                <% } %>
                <% } %>
                <li class="menu-link"><a href="/account">Account</a></li>
                <%# Only an admin chooses who is on the team and issues assistant connections, so only an admin is shown the way there. %>
                <% if (viewer.role === "admin" && viewer.kind === "person") { %><li class="menu-link"><a href="/people">People</a></li><% } %>
                <% if (viewer.role === "admin" && viewer.kind === "person" && !viewer.readOnly) { %><li class="menu-link"><a href="/connections">Connections</a></li><% } %>
                <%# The demo has nobody to sign out. Its About page is in every footer. %>
                <% if (!viewer.demo) { %>
                <li class="menu-link">
                  <form method="post" action="/sign-out" class="sign-out">
                    <button type="submit" class="link">Sign out</button>
                  </form>
                </li>
                <% } %>
                <%# The rules every page follows, quietly, at the foot of the menu. %>
                <li class="menu-link menu-foot"><a href="/roles">Who may do what</a></li>
              </ul>
            </details>
          </li>
        </ul>
        <% } %>
      </nav>
    </header>
    <main id="main" class="container">
      <% if (locals.refused) { %>
      <p role="alert" class="refused"><%= locals.refused %></p>
      <% } %>
      <% if (locals.saved) { %>
      <p role="status" class="saved"><%= locals.saved %></p>
      <% } %>
