<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title><%= title %> - Proofdesk</title>
    <link rel="icon" href="/assets/brand.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/pico.min.css" />
    <link rel="stylesheet" href="/assets/theme.css" />
    <link rel="stylesheet" href="/assets/site.css" />
  </head>
  <body>
    <%# The first stop on every page: keyboard users can jump past the header's links. %>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <% if (demo) { %>
      <p class="demo-strip">Demo: sample data, shared with everyone who visits. It resets itself about once a day.</p>
      <% } %>
      <nav class="container">
        <ul>
          <li><a href="/tickets" class="brand"><img src="/assets/brand.svg" alt="" width="24" height="24" /><strong>Proofdesk</strong></a></li>
        </ul>
        <% if (viewer) { %>
        <ul class="links">
          <li class="tickets-link"><a href="/tickets">Tickets</a></li>
          <%# Only an admin chooses who is on the team, so only an admin is shown the way there. %>
          <% if (viewer.role === "admin" && viewer.kind === "person") { %><li class="people-link"><a href="/people">People</a></li><% } %>
          <%# The read-only admin preview cannot file a ticket, so it is not offered one. %>
          <% if (!viewer.readOnly) { %><li><a href="/tickets/new" role="button">New ticket</a></li><% } %>
        </ul>
        <ul class="account">
          <% if (viewer.demo && demoPeople.length > 0) { %>
          <li class="viewer">
            <details class="dropdown switch-role">
              <summary>Signed in as <strong><%= viewer.name %></strong> <small class="role-label"><%= viewerRoleWord %></small> <span class="switch-label">Switch role</span></summary>
              <ul>
                <% for (const person of demoPeople.filter((p) => p.id !== viewer.id)) { %>
                <li>
                  <form method="post" action="/sign-in/dev">
                    <input type="hidden" name="id" value="<%= person.id %>" />
                    <input type="hidden" name="next" value="<%= here %>" />
                    <button type="submit" class="link"><%= person.readOnly ? "Admin preview (read-only)" : `View as ${person.name}` %></button>
                  </form>
                </li>
                <% } %>
              </ul>
            </details>
          </li>
          <% } else { %>
          <%# The name opens the person's own account page: who Proofdesk thinks they are. %>
          <li class="viewer">Signed in as <a href="/account" class="account-link"><strong><%= viewer.name %></strong></a> <small class="role-label"><%= viewerRoleWord %></small></li>
          <% } %>
          <li>
            <form method="post" action="/sign-out" class="sign-out">
              <button type="submit" class="link">Sign out</button>
            </form>
          </li>
        </ul>
        <% } %>
      </nav>
    </header>
    <main id="main" class="container">
      <% if (locals.refused) { %>
      <p role="alert" class="refused"><%= locals.refused %></p>
      <% } %>
      <% if (locals.saved) { %>
      <p role="status" class="saved"><%= locals.saved %></p>
      <% } %>
