<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title><%= title %> - Proofdesk</title>
    <link rel="icon" href="/assets/brand.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/pico.min.css" />
    <link rel="stylesheet" href="/assets/theme.css" />
    <link rel="stylesheet" href="/assets/site.css" />
  </head>
  <body>
    <%# The first stop on every page: keyboard users can jump past the header's links. %>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <% if (demo) { %>
      <p class="demo-strip">Demo: sample data, shared with everyone who visits. It resets itself when it has been quiet for a while.</p>
      <% } %>
      <%# Two groups and nothing else. Left: the brand and Tickets. Right: New ticket and one menu named
          for the person, which holds everything about them. %>
      <nav class="container">
        <ul class="links">
          <li><a href="/tickets" class="brand"><img src="/assets/brand.svg" alt="" width="24" height="24" /><strong>Proofdesk</strong></a></li>
          <% if (viewer) { %><li class="tickets-link"><a href="/tickets">Tickets</a></li><% } %>
        </ul>
        <% if (viewer) { %>
        <ul class="account">
          <%# The read-only admin preview cannot file a ticket, so it is not offered one. %>
          <% if (!viewer.readOnly) { %><li><a href="/tickets/new" role="button">New ticket</a></li><% } %>
          <li class="viewer">
            <%# A native details element, so it opens and closes with scripts off. menus.js adds Escape and closing when focus leaves. %>
            <details class="dropdown person-menu">
              <summary><strong><%= viewer.name %></strong><% if (viewerRoleWord !== viewer.name) { %> <small class="role-label"><%= viewerRoleWord %></small><% } %></summary>
              <ul>
                <% if (viewer.demo && demoPeople.length > 0) { %>
                <%# All three roles, each with one line on what to try as it. The current one is named, not offered. %>
                <li class="menu-heading">Switch role</li>
                <% for (const person of demoPeople) { %>
                <% const roleName = person.readOnly ? "Admin preview (read-only)" : `View as ${person.name}`; %>
                <li class="role">
                  <% if (person.id === viewer.id) { %>
                  <span class="role-current" aria-current="true"><%= person.readOnly ? "Admin preview (read-only)" : person.name %> (you)</span>
                  <% } else { %>
                  <form method="post" action="/sign-in/dev">
                    <input type="hidden" name="id" value="<%= person.id %>" />
                    <input type="hidden" name="next" value="<%= here %>" />
                    <button type="submit" class="link" aria-describedby="role-try-<%= person.id %>"><%= roleName %></button>
                  </form>
                  <% } %>
                  <small class="role-try" id="role-try-<%= person.id %>"><%- include("role-try", { person }) %></small>
                </li>
                <% } %>
                <% } %>
                <li class="menu-link"><a href="/account">Account</a></li>
                <%# Only an admin chooses who is on the team and issues assistant connections, so only an admin is shown the way there. %>
                <% if (viewer.role === "admin" && viewer.kind === "person") { %><li class="menu-link"><a href="/people">People</a></li><% } %>
                <% if (viewer.role === "admin" && viewer.kind === "person" && !viewer.readOnly) { %><li class="menu-link"><a href="/connections">Connections</a></li><% } %>
                <% if (viewer.demo) { %>
                <li class="menu-link"><a href="/sign-in">About this demo</a></li>
                <% } else { %>
                <li class="menu-link">
                  <form method="post" action="/sign-out" class="sign-out">
                    <button type="submit" class="link">Sign out</button>
                  </form>
                </li>
                <% } %>
              </ul>
            </details>
          </li>
        </ul>
        <% } %>
      </nav>
    </header>
    <main id="main" class="container">
      <% if (locals.refused) { %>
      <p role="alert" class="refused"><%= locals.refused %></p>
      <% } %>
      <% if (locals.saved) { %>
      <p role="status" class="saved"><%= locals.saved %></p>
      <% } %>
