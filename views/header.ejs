<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title><%= title %> - Support Desk</title>
    <link rel="stylesheet" href="/assets/pico.min.css" />
    <link rel="stylesheet" href="/assets/site.css" />
  </head>
  <body>
    <header class="container">
      <nav>
        <ul>
          <li><a href="/tickets"><strong>Support Desk</strong></a></li>
        </ul>
        <% if (viewer) { %>
        <ul>
          <li><a href="/tickets">Tickets</a></li>
          <li><a href="/tickets/new" role="button">New ticket</a></li>
        </ul>
        <% } %>
      </nav>
    </header>
    <main class="container">
      <% if (demo) { %>
      <p><mark>Demo: sample data, shared with everyone who visits.</mark></p>
      <% } %>
      <% if (viewer) { %>
      <form method="post" action="/sign-out">
        <small>Signed in as <%= viewer.name %> (<%= viewer.role %>). <button type="submit" class="outline secondary sign-out">Sign out</button></small>
      </form>
      <% } %>
