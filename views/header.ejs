<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title><%= title %> - Support Desk</title>
    <link rel="stylesheet" href="/assets/pico.min.css" />
    <link rel="stylesheet" href="/assets/site.css" />
  </head>
  <body>
    <header class="container">
      <nav>
        <ul>
          <li><a href="/tickets"><strong>Support Desk</strong></a></li>
        </ul>
        <% if (viewer) { %>
        <ul>
          <li><a href="/tickets">Tickets</a></li>
          <li><a href="/tickets/new" role="button">New ticket</a></li>
          <li class="viewer">Signed in as <strong><%= viewer.name %></strong> <small class="role-label"><%= viewer.role %></small></li>
          <li>
            <form method="post" action="/sign-out" class="sign-out">
              <button type="submit" class="outline secondary">Sign out</button>
            </form>
          </li>
        </ul>
        <% } %>
      </nav>
    </header>
    <main class="container">
      <% if (demo) { %>
      <p><mark>Demo: sample data, shared with everyone who visits.</mark></p>
      <% } %>
      <% if (locals.saved) { %>
      <p role="status" class="saved"><%= locals.saved %></p>
      <% } %>
