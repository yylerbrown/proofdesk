<%- include("header") %>
<div class="column-wide">
<h1>People</h1>
<p>Choose who is on the support team.</p>
<% if (note) { %>
<p class="role-note"><small><%= note %></small></p>
<% } %>

<% if (people.length === 0) { %>
<p class="empty"><%= emptyLine %></p>
<% } else { %>
<div class="overflow-auto">
  <table class="people">
    <thead>
      <tr><th scope="col">Person</th><th scope="col">Role</th></tr>
    </thead>
    <tbody>
      <% for (const person of people) { %>
      <tr>
        <%# The email address under the name, since anyone can choose their display name, then quiet
            words for how and when they first signed in. A made-up person has none of these. %>
        <td class="user-text"><span class="person-name"><%- include("demo-name", { person: person.id === viewer.id ? viewer : person }) %></span><% if (person.email) { %><br /><small class="person-email"><%= person.email %></small><% } %><% if (person.signedInWith) { %><br /><small class="person-way"><%= person.signedInWith %></small><% } %><% if (person.firstSignedIn) { %><br /><small class="person-since">First signed in <%- include("time", { iso: person.firstSignedIn }) %></small><% } %></td>
        <td>
          <% if (person.locked) { %>
          <%= person.locked %><% if (person.locked === "You") { %>, <%= roleLabels[person.role] %><% } %>
          <% } else { %>
          <%# Choosing a role only opens its check, which says what the change would do. Nothing is
              saved from here, so the demo admin may try it too. %>
          <form method="get" action="/people/check" class="inline role-choice">
            <input type="hidden" name="person" value="<%= person.id %>" />
            <label>
              <span class="visually-hidden">Role of <%= person.name %></span>
              <select name="role">
                <% for (const role of roles) { %>
                <option value="<%= role %>" <% if (role === person.role) { %>selected<% } %>><%= roleLabels[role] %></option>
                <% } %>
              </select>
            </label>
            <button type="submit" class="secondary">Check this change</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } %>

<ul class="role-lines">
  <% for (const role of roles) { %><li><small><%= roleLines[role] %></small></li><% } %>
</ul>

<%# The record of role changes is folded to one line, and left out until there is one. %>
<% if (changes.length > 0) { %>
<details class="role-changes">
  <summary>Role changes (<%= changes.length %>)</summary>
  <ul>
    <% for (const change of changes) { %>
    <li><%- include("time", { iso: change.at }) %>. <span class="user-text"><%= change.sentence %></span></li>
    <% } %>
  </ul>
</details>
<% } %>
</div>
<%- include("footer") %>
