<%- include("header") %>
<h1>New ticket</h1>

<form method="post" action="/tickets">
  <label>
    Title
    <input type="text" name="title" value="<%= values.title %>" required <% if (errors.title) { %>aria-invalid="true"<% } %> />
    <% if (errors.title) { %><small><%= errors.title.join(" ") %></small><% } %>
  </label>

  <label>
    Description
    <textarea name="description" rows="6" required <% if (errors.description) { %>aria-invalid="true"<% } %>><%= values.description %></textarea>
    <% if (errors.description) { %><small><%= errors.description.join(" ") %></small><% } %>
  </label>

  <label>
    Where did this happen? (optional, a link)
    <input type="url" name="where_url" value="<%= values.where_url %>" placeholder="https://" <% if (errors.where_url) { %>aria-invalid="true"<% } %> />
    <% if (errors.where_url) { %><small><%= errors.where_url.join(" ") %></small><% } %>
  </label>

  <label>
    How will we know it's fixed? (optional)
    <textarea name="fix_check" rows="3" <% if (errors.fix_check) { %>aria-invalid="true"<% } %>><%= values.fix_check %></textarea>
    <% if (errors.fix_check) { %><small><%= errors.fix_check.join(" ") %></small><% } %>
  </label>

  <button type="submit">File ticket</button>
</form>
<%- include("footer") %>
