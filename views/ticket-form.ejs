<%- include("header") %>
<%
  // The same form files a ticket and edits one. When editing, it posts to /tickets/KEY/edit.
  const editKey = action.endsWith("/edit") ? action.split("/")[2] : null;
  const fixCheckDescribedBy = errors.fix_check ? "fix_check-error fix_check-hint" : "fix_check-hint";
  // After a refused submit, focus goes to the first box with a message, in form order, so a
  // keyboard or screen reader user lands on what to fix.
  const firstError = ["title", "description", "fix_check", "where_url"].find((name) => errors[name]);
  const focusIf = (name) => (firstError === name ? "autofocus" : "");
%>
<h1><%= editKey ? "Edit ticket" : title %></h1>
<% if (locals.alreadyFiled) { %>
<p class="notice already-filed" role="status">This form was already filed as <a href="/tickets/<%= alreadyFiled.key %>"><%= alreadyFiled.key %></a>. <a href="/tickets/new">Start a new ticket</a>.</p>
<% } %>

<% if (locals.changedElsewhere) { %>
<%# Saving over a newer version was refused: what was typed stays in the boxes, and the form now
    carries the newer version, so saving again is a deliberate choice. %>
<%# It names only what the other person changed, with the text that box holds now. %>
<p role="alert" class="refused changed-elsewhere">Someone changed this ticket while you were editing. Your text is kept below: compare it with the current ticket, then save again. <% if (locals.changedByOthers?.length) { %>They changed: <% changedByOthers.forEach((change, index) => { %><%= index > 0 ? "; " : "" %><%= change.name %>, <% if (change.now) { %>now "<span class="user-text"><%= change.now %></span>"<% } else { %>now empty<% } %><% }) %>. <% } else if (locals.changedByOthers) { %>None of its text changed, only something else such as its status. <% } %><% if (locals.differ?.length) { %>Different on the ticket now: <%= differ.join(", ") %>. <% } %><a href="/tickets/<%= editKey %>" target="_blank" rel="noopener">Open the current ticket in a new tab</a></p>
<% } %>

<% if (locals.versionUnreadable) { %>
<%# The hidden version has no box of its own, so its problem is said here. %>
<p role="alert" class="refused">This form could not be checked against the ticket, so nothing was saved. <a href="/tickets/<%= editKey %>/edit">Open the edit form again</a>.</p>
<% } %>

<% if (locals.readOnly) { %>
<%# The demo's admin preview changes nothing, so it gets no form to fill in and then lose. %>
<p class="notice read-only-note">Demo Admin (read-only) changes nothing. Switch to Demo Customer to file a ticket.</p>
<p><a href="/tickets">Back to the ticket list</a></p>
<% } else { %>
<% if (locals.sample) { %>
<p class="notice sample-note">These boxes hold a sample. File it as it is, or change it first.</p>
<% } %>
<form method="post" action="<%= action %>">
  <% if (locals.formId) { %><input type="hidden" name="form" value="<%= formId %>" /><% } %>
  <%# The version of the ticket this form was filled from, so a save over a newer one is refused. %>
  <% if (locals.version) { %><input type="hidden" name="expected_version" value="<%= version %>" /><% } %>
  <%# A fingerprint of what each box held when the form was opened, used only to say what someone else changed. %>
  <% if (locals.loaded) { %>
  <% for (const field of ["title", "description", "where_url", "fix_check"]) { %>
  <input type="hidden" name="loaded_<%= field %>" value="<%= loaded[field] %>" />
  <% } %>
  <% } %>
  <%# The form does not ask for the page where it happened: few people have one to give, and the
      API still takes it. A link the ticket already has rides along unseen, so editing never
      drops it. Only a link the server refused gets its box back, with the reason under it. %>
  <% if (values.where_url && !errors.where_url) { %><input type="hidden" name="where_url" value="<%= values.where_url %>" /><% } %>
  <%# Each box's minlength and maxlength are the server's limits for it, so the browser stops at the
      same length and says when a title is too short. The description is the one exception, below. %>
  <%# The one hint sits inside its label, so the box is named by the label words alone and the hint is read once, as its description. %>
  <label>
    <span id="title-label">Title</span>
    <input type="text" name="title" value="<%= values.title %>" required minlength="3" maxlength="120" aria-labelledby="title-label" <% if (errors.title) { %>aria-invalid="true" aria-describedby="title-error"<% } %> <%= focusIf("title") %> />
  </label>
  <% if (errors.title) { %><small id="title-error"><%= errors.title.join(" ") %></small><% } %>

  <%# The description has no maxlength: the browser would cut a long paste off without a word.
      The count under it shows as the text nears the limit, and the server says how far over it is. %>
  <label>
    <span id="description-label">Description</span>
    <textarea name="description" rows="3" required aria-labelledby="description-label" data-count-limit="<%= descriptionLimit %>" data-count-into="description-count" <% if (errors.description) { %>aria-invalid="true" aria-describedby="description-error description-count"<% } else { %>aria-describedby="description-count"<% } %> <%= focusIf("description") %>><%= values.description %></textarea>
    <small id="description-count" class="hint char-count" aria-live="polite" hidden></small>
  </label>
  <% if (errors.description) { %><small id="description-error"><%= errors.description.join(" ") %></small><% } %>

  <label>
    <span id="fix_check-label">How will we know it's fixed? (optional)</span>
    <small id="fix_check-hint" class="hint">One thing you can check yourself, like "I can sign in on my phone". The team asks you to confirm the fix against it.</small>
    <% if (locals.checkLocked) { %>
    <textarea rows="3" readonly aria-labelledby="fix_check-label" aria-describedby="fix_check-locked"><%= values.fix_check %></textarea>
    <small id="fix_check-locked">The customer's own words. Only they can change them; offer a clearer check on the ticket instead.</small>
    <% } else { %>
    <textarea name="fix_check" rows="3" maxlength="500" aria-labelledby="fix_check-label" aria-describedby="<%= fixCheckDescribedBy %>" <% if (errors.fix_check) { %>aria-invalid="true"<% } %> <%= focusIf("fix_check") %>><%= values.fix_check %></textarea>
    <% } %>
  </label>
  <% if (errors.fix_check) { %><small id="fix_check-error"><%= errors.fix_check.join(" ") %></small><% } %>

  <% if (errors.where_url) { %>
  <label>
    Page where it happened (optional)
    <input type="url" name="where_url" value="<%= values.where_url %>" maxlength="500" aria-invalid="true" aria-describedby="where_url-error" <%= focusIf("where_url") %> />
  </label>
  <small id="where_url-error"><%= errors.where_url.join(" ") %></small>
  <% } %>

  <% if (editKey && viewer && viewer.role !== "customer") { %>
  <p class="status-rule"><small>The customer confirms a fix with Yes; the team can also resolve with a reason.</small></p>
  <% } %>
  <div class="form-actions">
    <button type="submit"><%= submitLabel %></button>
    <a href="<%= editKey ? `/tickets/${editKey}` : "/tickets" %>">Cancel</a>
  </div>
</form>
<% } %>
<%- include("footer") %>
