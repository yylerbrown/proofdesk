<%- include("header") %>
<%
  // The same form files a ticket and edits one. When editing, it posts to /tickets/KEY/edit.
  const editKey = action.endsWith("/edit") ? action.split("/")[2] : null;
  const fixCheckDescribedBy = errors.fix_check ? "fix_check-error fix_check-hint" : "fix_check-hint";
%>
<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/tickets">Tickets</a></li>
    <% if (editKey) { %>
    <li><a href="/tickets/<%= editKey %>"><%= editKey %></a></li>
    <li>Edit</li>
    <% } else { %>
    <li>New</li>
    <% } %>
  </ul>
</nav>
<h1><%= editKey ? "Edit ticket" : title %></h1>
<% if (locals.alreadyFiled) { %>
<p class="notice already-filed" role="status">This form was already filed as <a href="/tickets/<%= alreadyFiled.key %>"><%= alreadyFiled.key %></a>. <a href="/tickets/new">Start a new ticket</a>.</p>
<% } %>

<form method="post" action="<%= action %>">
  <% if (locals.formId) { %><input type="hidden" name="form" value="<%= formId %>" /><% } %>
  <label>
    Title
    <input type="text" name="title" value="<%= values.title %>" required <% if (errors.title) { %>aria-invalid="true" aria-describedby="title-error"<% } %> />
  </label>
  <% if (errors.title) { %><small id="title-error"><%= errors.title.join(" ") %></small><% } %>

  <label>
    Description
    <textarea name="description" rows="3" required <% if (errors.description) { %>aria-invalid="true" aria-describedby="description-error"<% } %>><%= values.description %></textarea>
  </label>
  <% if (errors.description) { %><small id="description-error"><%= errors.description.join(" ") %></small><% } %>

  <label>
    How will we know it's fixed? (optional)
    <small id="fix_check-hint" class="hint">One thing you can check yourself, like "I can sign in on my phone". The team asks you to confirm the fix against it.</small>
    <% if (locals.checkLocked) { %>
    <textarea rows="3" readonly aria-describedby="fix_check-locked"><%= values.fix_check %></textarea>
    <small id="fix_check-locked">The customer's own words. Only they can change them; offer a clearer check on the ticket instead.</small>
    <% } else { %>
    <textarea name="fix_check" rows="3" aria-describedby="<%= fixCheckDescribedBy %>" <% if (errors.fix_check) { %>aria-invalid="true"<% } %>><%= values.fix_check %></textarea>
    <% } %>
  </label>
  <% if (errors.fix_check) { %><small id="fix_check-error"><%= errors.fix_check.join(" ") %></small><% } %>

  <label>
    Page where it happened (optional)
    <input type="url" name="where_url" value="<%= values.where_url %>" <% if (errors.where_url) { %>aria-invalid="true" aria-describedby="where_url-error"<% } %> />
  </label>
  <% if (errors.where_url) { %><small id="where_url-error"><%= errors.where_url.join(" ") %></small><% } %>

  <% if (editKey && viewer && viewer.role !== "customer") { %>
  <p class="status-rule"><small>The customer confirms a fix with Yes; the team can also resolve with a reason.</small></p>
  <% } %>
  <% if (!editKey) { %>
  <p class="initial-status">Initial status: <span class="badge status-new">New</span></p>
  <% } %>
  <div class="form-actions">
    <button type="submit"><%= submitLabel %></button>
    <a href="<%= editKey ? `/tickets/${editKey}` : "/tickets" %>">Cancel</a>
  </div>
</form>
<%- include("footer") %>
