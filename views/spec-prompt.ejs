<%# One quiet line suggesting the team ask their own assistant for a test spec, while the ticket has none and is not handed to an assistant. It opens to the command to paste. Proofdesk contacts no assistant itself. %>
<% if (specPrompt) { %>
<% const words = `Using Proofdesk, write a test spec for ${specPrompt.key}`; %>
<details class="spec-prompt">
  <summary>Want better results? Ask your assistant to spec this ticket.</summary>
  <pre class="paste"><code><%= words %></code></pre>
  <button type="button" class="copy secondary" data-copy="<%= words %>" aria-label="Copy the prompt" hidden>Copy</button>
  <p><small><% if (specPrompt.connectUrl) { %><a href="<%= specPrompt.connectUrl %>">Connect your assistant</a> · <% } %><a href="/assistant-run">See an assistant's work</a></small></p>
</details>
<% } %>
