<%- include("header") %>
<div class="column-narrow">
<h1>Delete <%= ticket.key %> permanently?</h1>
<p><strong><%= ticket.title %></strong></p>

<p>This removes the title, the description, the link, the check, the conversation and the whole history of this ticket. It cannot be undone. Only the number <%= ticket.key %>, the time and your account id are kept, so that the number is never used again.</p>
<p>It does not reach backups, the host's snapshots of the disk until they expire, or anything already sent elsewhere.</p>

<form method="post" action="/tickets/<%= ticket.key %>/delete">
  <label>
    Type <%= ticket.key %> to confirm
    <input type="text" name="confirm" autocomplete="off" required <% if (error) { %>aria-invalid="true" aria-describedby="confirm-error"<% } %> />
    <% if (error) { %><small id="confirm-error"><%= error %></small><% } %>
  </label>
  <div class="choice">
    <a href="/tickets/<%= ticket.key %>" role="button" class="secondary outline">Keep ticket</a>
    <button type="submit" class="danger">Delete permanently</button>
  </div>
</form>
</div>
<%- include("footer") %>
