<%# Everything an assistant left on a ticket, in one quiet card with no headings: the one thing
    it proposes, the decision a person is asked to make while it is open,
    and the rest folded under Details. After a person decides, one line says how it ended. A
    test a person proposed reads the same way, under their name. Nothing here is verified. %>
<% const spec = card.spec; %>
<section class="assistant-card" aria-label="<%= card.from %>">
  <%# A request for review is said once, on the ticket's card above, with its step. %>
  <p class="card-from"><small><%= card.from %></small></p>
  <%# On the demo's recorded run: when it was recorded, and under which key the assistant knew it. %>
  <% if (card.recordedAs) { %><p class="card-recorded"><small>Recorded on <time datetime="2026-11-18T12:00:00.000Z" data-day><%= formatDay("2026-11-18T12:00:00.000Z") %></time> on an earlier copy of this demo, where this ticket was <%= card.recordedAs %>. <a href="/assistant-run#how-it-was-run">How this was run</a></small></p><% } %>
  <% if (card.blocked) { %><p class="assistant-blocked"><strong>Assistant blocked:</strong> <span class="user-text"><%= card.blocked %></span></p><% } %>
  <% if (spec) { %><p class="card-proposal"><%= spec.state === "accepted" ? "Agreed test:" : "Suggested test:" %> <span class="user-text"><%= spec.summary %></span></p><% } %>
  <%# Accepting saves the test; it does not say the fix works. %>
  <% if (spec && spec.state === "accepted") { %><p class="card-outcome"><small>Test saved for the team to run.</small></p><% } %>
  <% if (card.discardedBy) { %><p class="card-outcome"><small>The suggested test was discarded by <%= card.discardedBy %>.</small></p><% } %>
  <% if (card.canDecide && spec && spec.state === "proposed") { %>
  <div class="card-decision">
    <form method="post" action="/tickets/<%= card.key %>/spec/decision">
      <input type="hidden" name="decision" value="accept" />
      <button type="submit" class="secondary compact">Accept test</button>
    </form>
    <form method="post" action="/tickets/<%= card.key %>/spec/decision">
      <input type="hidden" name="decision" value="discard" />
      <button type="submit" class="compact secondary">Discard</button>
    </form>
  </div>
  <% } %>
  <% if (spec || card.evidence.length > 0 || locals.changeUrl) { %>
  <details class="card-details">
    <summary>Details</summary>
    <% if (spec) { %>
    <p><small><%= spec.coverage.scenarios %> <%= spec.coverage.scenarios === 1 ? "scenario" : "scenarios" %>, proposed by <%= spec.proposed_by.name %><% if (spec.proposed_by.kind === "agent") { %> (AI assistant)<% } %>. Reported, not verified by Proofdesk.</small></p>
    <ol class="scenarios">
      <% for (const scenario of spec.scenarios) { %>
      <li>
        <p><strong class="user-text"><%= scenario.title %></strong></p>
        <p class="user-text">Given <%= scenario.given %></p>
        <p class="user-text">When <%= scenario.when %></p>
        <p class="user-text">Then <%= scenario.then %></p>
        <% if (scenario.test_name) { %><p><small>Test: <code class="user-text"><%= scenario.test_name %></code></small></p><% } %>
        <p><small><%= scenario.has_evidence ? "Evidence names this scenario." : "No evidence names this scenario yet." %></small></p>
      </li>
      <% } %>
    </ol>
    <% } %>
    <%- include("change-line", { changeUrl: locals.changeUrl }) %>
    <% if (card.evidence.length > 0) { %>
    <p class="evidence-note"><small>Evidence, as reported by whoever attached it. Not checked by Proofdesk.</small></p>
    <%- include("evidence", { evidence: card.evidence }) %>
    <% } %>
  </details>
  <% } %>
</section>
