<%- include("header") %>
<%# The page that shows a new key: one message to paste into an AI agent, and the manual setup folded away under it. %>
<div class="column-form connection-created">
<h1><%= connection.demo ? "Your demo connection" : "Connection issued" %></h1>
<% if (!connection.demo) { %>
<p class="connection-facts"><span class="user-text"><%= connection.name %></span>. Suggestions: <%= suggestionWords %>.</p>
<% } %>
<p>Paste this into your AI agent:</p>
<pre class="paste" id="agent-paste"><code><%= paste %></code></pre>
<button type="button" class="copy" data-copy="<%= paste %>" aria-label="Copy the message for your AI agent" hidden>Copy</button>
<% if (connection.demo) { %>
<p class="key-once">The key is shown only once, on this page, and stops working <%- include("time", { iso: connection.expires_at }) %>.</p>
<% } else { %>
<p class="key-once">The key is shown only once, on this page.</p>
<% } %>
<p class="reload-note">Reloading this page issues another connection.</p>

<%# What to do once the message is pasted: only the lines this connection's settings allow. %>
<% if (!connection.demo) { %>
<div class="connection-next">
  <p class="next-label">Next</p>
  <p>Hand it a ticket: open <a href="/tickets?owner=me">a ticket you own</a>, then More options, Hand to an AI assistant.</p>
  <% if (suggestions !== "off") { %>
  <p>Or let it suggest proofs: while your assistant is listening, <a href="/tickets/new">file a ticket</a><%= suggestions === "when_asked" ? " and press Suggest ways to prove it" : "" %>.</p>
  <% } %>
</div>
<% } else if (locals.sampleKey) { %>
<div class="connection-next">
  <p class="next-label">Next</p>
  <p>Its ticket is <a href="/tickets/<%= sampleKey %>"><%= sampleKey %></a>, the sample ticket for assistants, already handed to it.</p>
</div>
<% } %>

<details class="connection-help">
  <summary>If that did not work</summary>
  <p>Add it to Claude Code by pasting this in a terminal:</p>
  <% const claudeCode = `claude mcp add --transport http proofdesk ${address}/mcp --header "Authorization: Bearer ${key}"`; %>
  <pre class="paste command" id="claude-code"><code>claude mcp add --transport http proofdesk <%= address %>/mcp --header "Authorization: Bearer <%= key %>"</code></pre>
  <button type="button" class="copy secondary" data-copy="<%= claudeCode %>" aria-label="Copy the Claude Code command" hidden>Copy</button>
  <p>Or add it to a project's <code>.mcp.json</code>:</p>
  <% const mcpJson = JSON.stringify({ mcpServers: { proofdesk: { type: "http", url: `${address}/mcp`, headers: { Authorization: `Bearer ${key}` } } } }, null, 2); %>
  <pre class="paste command" id="mcp-json"><code><%= mcpJson %></code></pre>
  <button type="button" class="copy secondary" data-copy="<%= mcpJson %>" aria-label="Copy the .mcp.json entry" hidden>Copy</button>
  <p>Check the key works:</p>
  <% const curlCommand = `curl -H "Authorization: Bearer ${key}" "${address}/api/tickets"`; %>
  <pre class="paste command" id="curl-command"><code>curl -H "Authorization: Bearer <%= key %>" "<%= address %>/api/tickets"</code></pre>
  <button type="button" class="copy secondary" data-copy="<%= curlCommand %>" aria-label="Copy the curl command" hidden>Copy</button>
  <% if (connection.demo) { %>
  <p class="see-what-it-wrote">To see what it wrote, view as Demo Team Member with the menu at the top right<%= locals.sampleKey ? ` and open ${sampleKey}` : "" %>.</p>
  <% } else { %>
  <p class="see-what-it-wrote">What it writes shows on each ticket's page, and everything it asks for is on <a href="/connections/<%= connection.id %>">this connection's page</a>.</p>
  <% } %>
</details>
</div>
<%- include("footer") %>
