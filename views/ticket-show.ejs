<%- include("header") %>
<p class="back"><a href="/tickets">Back to all tickets</a></p>

<hgroup>
  <h1 class="user-text"><%= ticket.title %></h1>
  <p class="meta"><%= ticket.key %> <%- include("status-badge", { status: ticket.status }) %><% if (ticket.ready_at && ticket.status === "in_progress") { %>, waiting for <%= viewerRole === "customer" ? "you" : "the customer who filed this ticket" %><% } %> · <% if (ticket.owner_name) { %>Owner <%= ticket.owner_name %><% } else { %>Unassigned<% } %> · filed <%- include("time", { iso: ticket.created_at }) %><% if (allowed.edit) { %> · <a href="/tickets/<%= ticket.key %>/edit" class="edit-link">Edit ticket</a><% } %></p>
</hgroup>
<% const staff = viewerRole !== "customer"; %>
<%
  // After a refused form, its box with the message gets focus, so the visitor lands on it.
  const focusIf = (form, name) => (problem?.form === form && problem.focus === name ? "autofocus" : "");
  // Each form that changes the ticket says which version of it this page shows, so a press on a
  // page left open after someone else changed the ticket is refused instead of acting on it.
  const versionField = `<input type="hidden" name="expected_version" value="${Number(ticket.version)}" />`;
%>

<%# The viewer's one next action, right under the status: the step that is possible now. %>
<% if (locals.nextStep) { %>
<div class="next-action">
  <%# Before the owner asks, the customer's own check, so they read what will be checked first. %>
  <% if (nextStep.customerCheck !== undefined) { %>
  <p class="next-check"><% if (nextStep.customerCheck) { %>The customer will check: <span class="user-text"><%= nextStep.customerCheck %></span><% } else if (nextStep.teamCheck) { %>The customer will check the team's check: <span class="user-text"><%= nextStep.teamCheck %></span><% } else { %>The customer gave no check.<% } %></p>
  <% } %>
  <% if (nextStep.form) { %>
  <form method="post" action="<%= nextStep.form.action %>">
    <%- versionField %>
    <% for (const [name, value] of Object.entries(nextStep.form.fields ?? {})) { %>
    <input type="hidden" name="<%= name %>" value="<%= value %>" />
    <% } %>
    <button type="submit"><%= nextStep.label %></button>
  </form>
  <% } else { %>
  <a href="<%= nextStep.href %>" role="button"><%= nextStep.label %></a>
  <% } %>
  <% if (nextStep.note) { %><small class="next-note"><%= nextStep.note %></small><% } %>
  <%# The optional details form is further down; this link leads there, and opens it with scripts. %>
  <% if (nextStep.detailsId) { %><small class="next-details"><a href="#<%= nextStep.detailsId %>" data-opens="<%= nextStep.detailsId %>">Add details first (optional)</a></small><% } %>
</div>
<% } %>

<%# Another demo customer filed the recorded run, so only the team opens it. %>
<% if (locals.recordedRun && viewerRole !== "customer") { %>
<%# The title and the description say it is a recorded run and why its words name another key, so this line is only the way to how it was run. %>
<p class="recorded-run"><a href="/assistant-run#how-it-was-run">How this was run</a></p>
<% } %>
<%# On the demo: the next role to view this same ticket as, or where resolved tickets are listed. %>
<% if (locals.demoNext) { %>
<div class="demo-next">
  <% if (demoNext.resolved) { %>
  <%# The card below already says who resolved it, so this is only the way on. %>
  <p><a href="/tickets?status=resolved">See every resolved ticket</a></p>
  <% } else { %>
  <form method="post" action="/sign-in/dev">
    <input type="hidden" name="id" value="<%= demoNext.switchTo %>" />
    <input type="hidden" name="next" value="/tickets/<%= ticket.key %>" />
    <button type="submit" class="secondary outline"><%= demoNext.label %></button>
  </form>
  <% } %>
</div>
<% } %>

<% if (ticket.archived_at) { %>
<article>
  <p>This ticket was archived on <%- include("time", { iso: ticket.archived_at }) %>. It is hidden from the lists and cannot be changed until it is restored.</p>
  <% if (allowed.restore) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/restore">
    <button type="submit" class="compact">Restore ticket</button>
  </form>
  <% } %>
</article>
<% } %>

<%# Wide screens: what the ticket is about on the left, what a person acts on in the panel on
    the right, the conversation and history under the left part. Narrow screens: one column,
    with the panel between the description and the conversation. %>
<div class="ticket-layout" data-ticket-key="<%= ticket.key %>" data-ticket-version="<%= stamp.version %>" data-ticket-entries="<%= stamp.entries %>" data-ticket-handoffs="<%= stamp.handoffs %>" data-ticket-status="<%= ticket.status %>">
<div class="ticket-summary">
<%# The customer said it is not fixed, with a No or by reopening it: shown first, until the team
    asks them again, resolves it or reopens it. Their latest word is the one shown. %>
<% if (notFixedCard) { %>
<article class="customer-said-no" id="customer-said-no">
  <% if (viewerRole === "customer") { %>
  <h2><%= notFixedCard.reopened ? "You reopened it" : "You said it is not fixed" %></h2>
  <% } else { %>
  <h2><%= notFixedCard.reopened ? "The customer reopened it" : "The customer says it is not fixed" %></h2>
  <% } %>
  <% if (notFixedCard.words) { %>
  <blockquote class="user-text"><%= notFixedCard.words %></blockquote>
  <% } %>
  <p><small><%= notFixedCard.reopened ? "Reopened" : "Answered" %> <%- include("time", { iso: notFixedCard.at }) %>.</small></p>
  <% if (viewerRole === "customer") { %>
  <p>The team has your words. You will be asked again when they think it is fixed.</p>
  <% } else { %>
  <p>It is back with <strong><%= ticket.owner_name ?? "the team" %></strong>. Fix what the customer describes, then ask them again.</p>
  <% } %>
</article>
<% } %>
<%# The only tick inside the product, always with the words "Customer confirmed". %>
<% if (confirmed) { %>
<article class="confirmed">
  <img src="/assets/mark.svg" alt="" width="32" height="32" class="tick" />
  <p><strong>Customer confirmed it is fixed.</strong> <%- include("time", { iso: confirmed }) %></p>
</article>
<% } %>
<%# Resolved by the team, without the customer's Yes: said plainly to everyone, with the reason, and never with the tick. %>
<% if (ticket.resolution && ticket.resolution.by === "team") { %>
<article class="resolved-by-team">
  <% if (teamSaysFixed(ticket, viewerRole)) { %>
  <%# The customer reads it in their terms: the team's word, and that theirs is still to come. %>
  <p><strong>The team says it is fixed</strong></p>
  <p>You have not confirmed it.</p>
  <% } else { %>
  <p><strong><%= ticket.resolution.label %></strong></p>
  <% } %>
  <% if (ticket.resolution.note) { %><p class="user-text"><%= ticket.resolution.note %></p><% } %>
  <p><small><% if (ticket.resolution.resolved_by_name) { %><%= ticket.resolution.resolved_by_name %>, <% } %><%- include("time", { iso: ticket.resolution.at }) %>. <%= viewerRole === "customer" ? "If it is still happening, you can reopen it." : "The customer did not confirm it, and can reopen it." %><% if (staff && ticket.resolution.duplicate_of) { %> <a href="/tickets/<%= ticket.resolution.duplicate_of %>">Open <%= ticket.resolution.duplicate_of %></a><% } %></small></p>
</article>
<% } %>
<%# The customer's way back in. The team's Reopen sits with the status, in the side panel. %>
<% if (allowed.reopen && !staff) { %>
<details id="reopen" <% if (problem?.form === "reopen") { %>open<% } %>>
  <summary>Still happening?</summary>
  <form method="post" action="/tickets/<%= ticket.key %>/reopen">
    <%- versionField %>
    <label for="reopen-reason">What is happening again?</label>
    <textarea id="reopen-reason" name="reason" rows="3" required <% if (problem?.form === "reopen") { %>aria-invalid="true" aria-describedby="reopen-error"<% } %> <%= focusIf("reopen", "reason") %>><%= problem?.form === "reopen" ? problem.comment : "" %></textarea>
    <% if (problem?.form === "reopen") { %><small id="reopen-error"><%= problem.message %></small><% } %>
    <button type="submit" class="secondary compact">Still happening, reopen</button>
  </form>
</details>
<% } %>
<% if (allowed.answer) { %>
<article id="did-this-fix-it">
  <h2>Did this fix it?</h2>
  <p>The team says it is fixed. Please check it<% if (ticket.try_url) { %> here: <a href="<%= ticket.try_url %>" rel="noopener noreferrer nofollow" class="user-text"><%= ticket.try_url %></a><% } %>.</p>
  <% if (ticket.ask) { %>
  <% if (ticket.ask.response_to_no) { %>
  <p>What changed since you said it still fails:</p>
  <blockquote class="user-text"><%= ticket.ask.response_to_no %></blockquote>
  <% } %>
  <% if (ticket.ask.tried) { %>
  <p><%= ticket.owner_name ?? "The team" %> tried:</p>
  <blockquote class="user-text"><%= ticket.ask.tried %></blockquote>
  <% } %>
  <% if (ticket.ask.result) { %>
  <p>What happened:</p>
  <blockquote class="user-text"><%= ticket.ask.result %></blockquote>
  <% } %>
  <% } %>
  <% if (ticket.agreed_check) { %>
  <p>Team's check:</p>
  <blockquote class="user-text"><%= ticket.agreed_check %></blockquote>
  <% if (allowed.adoptCheck) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/adopt-check">
    <%- versionField %>
    <button type="submit" class="secondary compact">Use these words as my check</button>
  </form>
  <% } %>
  <% } %>
  <% if (ticket.fix_check) { %>
  <p>In your words:</p>
  <blockquote class="user-text"><%= ticket.fix_check %></blockquote>
  <% } %>
  <% if (evidence.length > 0) { %>
  <p>What the team showed as proof. They report it; Proofdesk has not checked it.</p>
  <%- include("evidence", { evidence }) %>
  <% } %>
  <%- include("spec-coverage", { specPanel }) %>
  <form method="post" action="/tickets/<%= ticket.key %>/answer">
    <input type="hidden" name="fixed" value="yes" />
    <input type="hidden" name="ready_token" value="<%= ticket.ready_token %>" />
    <button type="submit" class="large">Yes, resolve ticket</button>
  </form>
  <form method="post" action="/tickets/<%= ticket.key %>/answer">
    <input type="hidden" name="fixed" value="no" />
    <input type="hidden" name="ready_token" value="<%= ticket.ready_token %>" />
    <label>
      No, it is not fixed. What is still wrong?
      <textarea id="answer-comment" name="comment" rows="3" required <% if (problem?.form === "answer") { %>aria-invalid="true" aria-describedby="answer-error"<% } %> <%= focusIf("answer", "comment") %>><%= problem?.form === "answer" ? problem.comment : "" %></textarea>
    </label>
    <% if (problem?.form === "answer") { %><small id="answer-error"><%= problem.message %></small><% } %>
    <button type="submit" class="secondary large">No, send it back</button>
  </form>
</article>
<% } %>

<h2>Description</h2>
<p class="user-text"><%= ticket.description %></p>

<% if (ticket.where_url) { %>
<p class="page-link">Page: <a href="<%= ticket.where_url %>" rel="noopener noreferrer nofollow" class="user-text"><%= ticket.where_url %></a></p>
<% } %>
<%# The code change, for the team, as one plain line like the page above. %>
<% if (staff && ticket.change_url) { %>
<p class="page-link">Change: <a href="<%= ticket.change_url %>" rel="noopener noreferrer nofollow" class="user-text"><%= ticket.change_url %></a></p>
<% } %>
<%# Everything an assistant left on the ticket is one card. Evidence a person attached, with no
    assistant's work beside it, is one closed line. The customer sees the proof when asked. %>
<% if (assistantCard) { %>
<%- include("assistant-card", { card: assistantCard }) %>
<% } else if (staff && evidence.length > 0) { %>
<details class="evidence-list">
  <summary>Evidence (<%= evidence.length %>)</summary>
  <p class="evidence-note">As reported by whoever attached it. Not checked by Proofdesk.</p>
  <%- include("evidence", { evidence }) %>
</details>
<% } %>
</div>

<%# The panel holds three things: who owns the ticket, its status, and the customer's check.
    Everything else the team can do waits under "More options" at the bottom of the main column. %>
<aside class="ticket-panel" aria-label="Owner and status">
<section>
  <h2>Owner</h2>
  <p><%= ticket.owner_name ?? "Unassigned" %></p>
  <% if (staff && allowed.take) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/take">
    <%- versionField %>
    <button type="submit" class="secondary compact">Assign to me</button>
  </form>
  <% } %>
  <% if (staff && allowed.handOff && handOffTo.length > 0) { %>
  <details <% if (problem?.form === "handOff") { %>open<% } %>>
    <summary>Hand off to…</summary>
    <form method="post" action="/tickets/<%= ticket.key %>/hand-off">
      <input type="hidden" name="expected_owner" value="<%= ticket.owner_id ?? "" %>" />
      <%- versionField %>
      <label>
        Team member
        <select name="to" <% if (problem?.form === "handOff") { %>aria-describedby="hand-off-error"<% } %> <%= focusIf("handOff", "to") %>>
          <% for (const member of handOffTo) { %>
          <option value="<%= member.id %>"><%= member.name %></option>
          <% } %>
        </select>
      </label>
      <% if (problem?.form === "handOff") { %><small id="hand-off-error" role="alert"><%= problem.message %></small><% } %>
      <button type="submit" class="secondary compact">Hand off</button>
    </form>
  </details>
  <% } %>
  <% if (staff && agentHelp.demoSample) { %>
  <p class="agent-help">Handed to <strong>demo assistants</strong>: each visitor's assistant connection works on this sample.</p>
  <% } %>
  <% if (staff && agentHelp.current) { %>
  <p class="agent-help">Handed to <strong><%= agentHelp.current.name %></strong> (AI assistant), since <%- include("time", { iso: agentHelp.current.granted_at }) %>.</p>
  <% if (allowed.endAgentWork) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/agent/end">
    <%- versionField %>
    <button type="submit" class="secondary outline compact">Stop the assistant</button>
  </form>
  <% } %>
  <% } %>
</section>

<section class="status-control">
  <h2>Status</h2>
  <% if (!staff) { %>
  <p><%- include("status-badge", { status: ticket.status }) %></p>
  <% } else { %>
  <%# The three statuses in one row: the current one marked, each other one a single press, or
      greyed with one short line saying why. Each comes from the allowed actions, so the page
      offers exactly what the server would accept. %>
  <div class="quick-answers status-row">
    <% for (const choice of statusRow.choices) { %>
    <% if (choice.kind === "current") { %>
    <%# Marked the way the list marks its selected filter, so "this is the current one" looks the same in both places. %>
    <span aria-current="true" class="status-current"><%- include("status-badge", { status: choice.status }) %></span>
    <% } else if (choice.kind === "press") { %>
    <form method="post" action="<%= choice.action %>">
      <%- versionField %>
      <% for (const [name, value] of Object.entries(choice.fields)) { %>
      <input type="hidden" name="<%= name %>" value="<%= value %>" />
      <% } %>
      <button type="submit" class="secondary"><%= statusLabels[choice.status] %></button>
    </form>
    <% } else if (choice.kind === "resolve") { %>
    <% const resolving = problem?.form === "resolve" ? (problem.values ?? {}) : {}; %>
    <%# No reason is chosen at first, so a hurried press can never claim a fix. While the
        customer's No stands "Fixed" is not offered. After a refused try, what they picked stays. %>
    <% const chosenReason = problem?.form === "resolve" ? (resolving.reason ?? "") : ""; %>
    <%# Resolved opens a reason and the button that resolves, rather than changing the status at once. %>
    <details class="resolve" <% if (problem?.form === "resolve") { %>open<% } %>>
      <summary role="button" class="secondary outline">Resolved</summary>
      <form method="post" action="/tickets/<%= ticket.key %>/resolve">
        <%- versionField %>
        <label>
          Reason
          <select name="reason" required <%= focusIf("resolve", "reason") %>>
            <% if (!chosenReason) { %><option value="" selected>Choose a reason</option><% } %>
            <% for (const [value, label] of Object.entries(resolveReasons)) { %>
            <%# While the customer's No or reopening is their standing word, "Fixed" would
                contradict them. The same rule as the callout at the top and the service. %>
            <% if (value === "fixed_no_reply" && notFixed) continue; %>
            <option value="<%= value %>" <% if (chosenReason === value) { %>selected<% } %>><%= label %></option>
            <% } %>
          </select>
        </label>
        <%# The stylesheet shows each of these only for the reason that needs it. %>
        <label class="resolve-duplicate">
          Duplicate of
          <input type="text" name="duplicate_of" placeholder="SUP-3" maxlength="20" value="<%= resolving.duplicate_of ?? "" %>" <%= focusIf("resolve", "duplicate_of") %> />
        </label>
        <label class="resolve-note">
          Why?
          <textarea name="note" rows="2" maxlength="500" <%= focusIf("resolve", "note") %>><%= resolving.note ?? "" %></textarea>
        </label>
        <% if (problem?.form === "resolve") { %><p><small id="resolve-error" role="alert"><%= problem.message %></small></p><% } %>
        <button type="submit" class="secondary compact" <% if (problem?.form === "resolve") { %>aria-describedby="resolve-error"<% } %>>Resolve</button>
      </form>
    </details>
    <% } else if (choice.kind === "reopen") { %>
    <details class="reopen" <% if (problem?.form === "reopen") { %>open<% } %>>
      <summary role="button" class="secondary outline"><%= statusLabels[choice.status] %></summary>
      <form method="post" action="/tickets/<%= ticket.key %>/reopen">
        <%- versionField %>
        <label for="reopen-reason">Why reopen it?</label>
        <textarea id="reopen-reason" name="reason" rows="2" required <% if (problem?.form === "reopen") { %>aria-invalid="true" aria-describedby="reopen-error"<% } %> <%= focusIf("reopen", "reason") %>><%= problem?.form === "reopen" ? problem.comment : "" %></textarea>
        <% if (problem?.form === "reopen") { %><small id="reopen-error" role="alert"><%= problem.message %></small><% } %>
        <button type="submit" class="secondary compact">Reopen</button>
      </form>
    </details>
    <% } else { %>
    <span><button type="button" class="secondary" disabled <% if (statusRow.why) { %>aria-describedby="status-why"<% } %>><%= statusLabels[choice.status] %></button></span>
    <% } %>
    <% } %>
  </div>
  <% if (statusRow.why) { %><p class="status-rule" id="status-why"><small><%= statusRow.why %></small></p><% } %>
  <% } %>
</section>

<%# The customer's check, in one quoted line. While the customer is asked, their answer card
    above shows it instead. %>
<% if ((ticket.fix_check || (!staff && ticket.agreed_check)) && !allowed.answer) { %>
<section>
  <h2>How will we know it's fixed?</h2>
  <%# The customer may take the team's clearer wording as their own. %>
  <% if (!staff && ticket.agreed_check) { %>
  <p><strong>Team's check</strong></p>
  <blockquote class="user-text"><%= ticket.agreed_check %></blockquote>
  <% if (allowed.adoptCheck) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/adopt-check">
    <%- versionField %>
    <button type="submit" class="secondary compact">Use these words as my check</button>
  </form>
  <% } %>
  <% if (ticket.fix_check) { %><p><strong>In your words</strong></p><% } %>
  <% } %>
  <% if (ticket.fix_check) { %>
  <blockquote class="user-text"><%= ticket.fix_check %></blockquote>
  <% } %>
</section>
<% } %>
</aside>

<div class="ticket-thread">
<h2 id="conversation">Conversation</h2>
<% if (entries.length === 0) { %>
<p>No replies yet.</p>
<% } %>
<% for (const item of entries) { %>
<article class="entry<% if (item.kind === "note") { %> note<% } %>">
  <header>
    <strong><%= item.author_name %></strong><% if (item.author_kind === "agent") { %> <span class="tag">AI agent</span><% } %>
    <small><% if (item.author_kind !== "agent") { %><%= item.author_role %> · <% } %><% if (item.kind === "note") { %><span class="note-label">internal note, the customer does not see this</span> · <% } %><%- include("time", { iso: item.created_at }) %></small>
  </header>
  <p class="user-text"><%= item.body %></p>
  <% if (item.based_on) { const source = entries.find((e) => e.id === item.based_on); if (source) { %>
  <p><small>Published from a note by <%= source.author_name %><% if (source.author_kind === "agent") { %> (AI agent)<% } %>. Only the team sees this line.</small></p>
  <% } } %>
  <%# Only wording an assistant suggested for the customer is offered for publishing: never a
      review request or its working notes, so nothing internal reaches the customer by one click. %>
  <% if (item.kind === "note" && item.author_kind === "agent" && item.purpose === "suggested_reply" && allowed.reply && viewerRole !== "customer") { %>
  <details class="publish">
    <summary>Publish as my reply</summary>
    <form method="post" action="/tickets/<%= ticket.key %>/entries">
      <input type="hidden" name="kind" value="reply" />
      <input type="hidden" name="based_on" value="<%= item.id %>" />
      <label>
        Reply to the customer, in your name
        <textarea name="body" rows="4" required><%= item.body %></textarea>
      </label>
      <button type="submit" class="secondary compact">Send as my reply</button>
    </form>
  </details>
  <% } %>
</article>
<% } %>

<%# Just after a message was sent: the line saying so, under the message it sent, where the
    browser lands. The landing script gives it focus. %>
<% if (locals.sent) { %>
<p role="status" class="saved" id="sent"><%= sent %></p>
<% } %>
<% if (allowed.reply) { %>
<form method="post" action="/tickets/<%= ticket.key %>/entries" class="reply-box">
  <% if (allowed.note) { %>
  <%# Who sees it: two tabs directly on top of the box. %>
  <fieldset class="kind-tabs">
    <legend class="visually-hidden">Who sees it</legend>
    <label><input type="radio" name="kind" value="reply" <% if (entry.kind !== "note") { %>checked<% } %> /> Reply to the customer</label>
    <label><input type="radio" name="kind" value="note" <% if (entry.kind === "note") { %>checked<% } %> /> Internal note</label>
  </fieldset>
  <% } else { %>
  <input type="hidden" name="kind" value="reply" />
  <% } %>
  <label for="entry-body" class="visually-hidden">Your message</label>
  <textarea id="entry-body" name="body" rows="3" required <% if (entry.error) { %>aria-invalid="true" aria-describedby="body-error" autofocus<% } %>><%= entry.body %></textarea>
  <% if (entry.error) { %><small id="body-error"><%= entry.error %></small><% } %>
  <%# With a choice of who sees it, a small script makes the button name that audience. %>
  <button type="submit" class="compact" <% if (allowed.note) { %>data-label-reply="Send reply to customer" data-label-note="Save internal note"<% } %>>Send</button>
</form>
<% } %>

<details class="history">
<summary>History (<%= history.length %>)</summary>
<div class="overflow-auto">
  <table>
    <thead>
      <tr>
        <th scope="col">When</th>
        <th scope="col">What</th>
        <th scope="col">Who</th>
      </tr>
    </thead>
    <tbody>
      <% for (const entry of history) { %>
      <tr>
        <td><%- include("time", { iso: entry.when }) %></td>
        <td><%= entry.what %></td>
        <td><%= entry.who %><% if (entry.role) { %> <small class="role-label"><%= entry.role %></small><% } %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
</details>

<%# Everything the panel does not hold, behind one closed disclosure: optional and rarer steps.
    After a refused form inside it, it opens on that form and its message. %>
<% const moreForms = ["agreedCheck", "evidence", "changeLink", "ready"]; %>
<% const removeAny = allowed.archive || allowed.delete; %>
<% const hasMore = specPrompt || (staff && (allowed.agreeCheck || allowed.attachEvidence || allowed.linkChange || allowed.markReady || allowed.withdrawQuestion || (allowed.giveToAgent && !agentHelp.current && agentHelp.candidates.length > 0))) || allowed.release || removeAny; %>
<% if (hasMore) { %>
<details class="more-options" id="more-options" <% if (moreForms.includes(problem?.form)) { %>open<% } %>>
<summary>More options</summary>
<%- include("spec-prompt", { specPrompt }) %>
<% if (staff && allowed.agreeCheck) { %>
<details <% if (problem?.form === "agreedCheck") { %>open<% } %>>
  <summary>Offer a clearer check</summary>
  <form method="post" action="/tickets/<%= ticket.key %>/agreed-check">
    <%- versionField %>
    <label>
      Team's check (leave empty to remove it)
      <textarea name="agreed_check" rows="3" <% if (problem?.form === "agreedCheck") { %>aria-invalid="true" aria-describedby="agreed-check-error"<% } %> <%= focusIf("agreedCheck", "agreed_check") %>><%= ticket.agreed_check ?? ticket.fix_check ?? "" %></textarea>
    </label>
    <% if (problem?.form === "agreedCheck") { %><small id="agreed-check-error"><%= problem.message %></small><% } %>
    <button type="submit" class="compact">Save team's check</button>
  </form>
</details>
<% } %>
<% if (staff && allowed.attachEvidence) { %>
<details <% if (problem?.form === "evidence") { %>open<% } %>>
  <summary>Attach evidence</summary>
  <form method="post" action="/tickets/<%= ticket.key %>/evidence">
    <label>
      Kind
      <select name="kind">
        <option value="check_run">I checked it</option>
        <option value="test">A test</option>
        <option value="change_link">A change</option>
        <option value="note">A note</option>
      </select>
    </label>
    <label>
      What it shows
      <input type="text" name="summary" required maxlength="500" <% if (problem?.form === "evidence") { %>aria-invalid="true" aria-describedby="evidence-error"<% } %> <%= focusIf("evidence", "summary") %> />
    </label>
    <% if (problem?.form === "evidence") { %><small id="evidence-error"><%= problem.message %></small><% } %>
    <label>
      Link (optional)
      <input type="url" name="link" placeholder="https://" <%= focusIf("evidence", "link") %> />
    </label>
    <button type="submit" class="secondary compact">Attach evidence</button>
  </form>
</details>
<% } %>
<% if (staff && allowed.linkChange) { %>
<details class="change-link" <% if (problem?.form === "changeLink") { %>open<% } %>><summary><%= ticket.change_url ? "Change the link" : "Add the code change link" %></summary>
<form method="post" action="/tickets/<%= ticket.key %>/change-link" id="change-link">
  <%- versionField %>
  <label>
    Link to the code change
    <input type="url" id="change-url" name="change_url" required <% if (problem?.form === "changeLink") { %>aria-invalid="true" aria-describedby="change-link-error"<% } %> <%= focusIf("changeLink", "change_url") %> />
  </label>
  <% if (problem?.form === "changeLink") { %><small id="change-link-error"><%= problem.message %></small><% } %>
  <button type="submit" class="secondary compact">Save change link</button>
</form>
</details>
<% } %>
<% if (staff && allowed.markReady) { %>
<% const asked = problem?.form === "ready" ? (problem.values ?? {}) : {}; %>
<% const ticked = problem?.form === "ready" ? (problem.evidenceIds ?? []) : []; %>
<%# The one press at the top asks with nothing more. The details are optional. %>
<details class="ask-details" id="ask" <% if (problem?.form === "ready") { %>open<% } %>>
<summary>Ask with details (optional)</summary>
<form method="post" action="/tickets/<%= ticket.key %>/ready" class="ask">
  <%- versionField %>
  <p><small>Every box is optional. The customer sees what you write.</small></p>
  <label>
    Page on the live site to try (optional)
    <input type="url" name="try_url" value="<%= asked.try_url ?? ticket.try_url ?? ticket.where_url ?? "" %>" <%= focusIf("ready", "try_url") %> />
  </label>
  <label>
    What did you try? (optional)
    <textarea name="tried" rows="2" <%= focusIf("ready", "tried") %>><%= asked.tried ?? "" %></textarea>
  </label>
  <label>
    What happened? (optional)
    <textarea name="result" rows="2" <%= focusIf("ready", "result") %>><%= asked.result ?? "" %></textarea>
  </label>
  <% if (ticket.customer_answer && !ticket.customer_answer.fixed) { %>
  <label>
    What changed since the customer said it still fails? (optional)
    <textarea name="response" rows="2" <%= focusIf("ready", "response") %>><%= asked.response ?? "" %></textarea>
  </label>
  <% } %>
  <% if (evidence.length > 0) { %>
  <fieldset>
    <legend>Evidence you relied on</legend>
    <% for (const item of evidence) { %>
    <label><input type="checkbox" name="evidence_ids" value="<%= item.id %>" <%= ticked.includes(String(item.id)) ? "checked" : "" %> /> <span class="user-text"><%= item.summary %></span></label>
    <% } %>
  </fieldset>
  <% } %>
  <% if (problem?.form === "ready") { %><p><small id="ready-error" role="alert"><%= problem.message %></small></p><% } %>
  <button type="submit" class="secondary compact" <% if (problem?.form === "ready") { %>aria-describedby="ready-error"<% } %>>Ask with these details</button>
</form>
</details>
<% } %>
<% if (staff && allowed.withdrawQuestion) { %>
<form method="post" action="/tickets/<%= ticket.key %>/withdraw-question">
  <%- versionField %>
  <button type="submit" class="secondary outline compact">Withdraw the question</button>
</form>
<% } %>
<% if (staff && allowed.giveToAgent && !agentHelp.current && agentHelp.candidates.length > 0) { %>
<details>
  <summary>Hand to an AI assistant…</summary>
  <form method="post" action="/tickets/<%= ticket.key %>/agent">
    <%- versionField %>
    <label>
      Connection
      <select name="connection_id">
        <% for (const c of agentHelp.candidates) { %>
        <option value="<%= c.id %>"><%= c.name %></option>
        <% } %>
      </select>
    </label>
    <p><small>It can work on this ticket only, within what its connection allows, until you stop it, hand the ticket on or ask the customer.</small></p>
    <button type="submit" class="secondary compact">Hand to assistant</button>
  </form>
</details>
<% } %>
<% if (allowed.release) { %>
<form method="post" action="/tickets/<%= ticket.key %>/release">
  <%- versionField %>
  <button type="submit" class="secondary outline compact">Release it</button>
</form>
<% } %>
<%# Archive and permanent delete: set apart, last. %>
<% if (removeAny) { %>
<div class="danger-zone" role="group" aria-label="Remove">
  <% if (allowed.archive) { %>
  <a href="/tickets/<%= ticket.key %>/archive" role="button" class="danger">Archive ticket</a>
  <% } %>
  <% if (allowed.delete) { %>
  <a href="/tickets/<%= ticket.key %>/delete" role="button" class="danger">Delete permanently</a>
  <% } %>
</div>
<% } %>
</details>
<% } %>
</div>
</div>
<%- include("footer") %>
