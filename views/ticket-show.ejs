<%- include("header") %>
<% const staff = viewerRole !== "customer"; %>
<%
  // After a refused form, its box with the message gets focus, so the visitor lands on it.
  const focusIf = (form, name) => (problem?.form === form && problem.focus === name ? "autofocus" : "");
  // Each form that changes the ticket says which version of it this page shows, so a press on a
  // page left open after someone else changed the ticket is refused instead of acting on it.
  const versionField = `<input type="hidden" name="expected_version" value="${Number(ticket.version)}" />`;
  const choices = statusRow ? statusRow.choices : [];
  // Choosing Resolved, or reopening a resolved ticket, shows its small form in the next step's
  // place. The Status menu links to this page with the step in the address, so it works with
  // scripts off; a refused form comes back open with what was chosen and typed.
  const resolveForm = choices.some((c) => c.kind === "resolve") && (step === "resolve" || problem?.form === "resolve");
  const reopenForm = staff && choices.some((c) => c.kind === "reopen") && (step === "reopen" || problem?.form === "reopen");
  // The customer's step after filing, what would prove it is fixed, shows in the check's place.
  const proofStep = proof.step;
  const stepForm = resolveForm || reopenForm || proofStep;
%>
<%# One column of reading width, the same for every ticket, role and width: the way back, the
    title, status and owner on one line, the ticket's own words, the customer's check, where it
    stands, the one next step, then the conversation and the quiet last row. %>
<div class="ticket-page column" data-ticket-key="<%= ticket.key %>" data-ticket-version="<%= stamp.version %>" data-ticket-entries="<%= stamp.entries %>" data-ticket-handoffs="<%= stamp.handoffs %>" data-ticket-status="<%= ticket.status %>">
<p class="back"><a href="/tickets"><%= staff ? "All tickets" : "My tickets" %></a> / <%= ticket.key %></p>
<h1 class="user-text"><%= ticket.title %></h1>

<% if (staff) { %>
<%# Status and owner, two small menus on one line. Each is a native details element, so it
    opens and closes with scripts off; the menus script adds Escape and closing when focus
    leaves. Only one is open at a time. An open list floats over the page under its own button,
    like the header's menu, so opening or closing it moves nothing. A fact this viewer cannot
    change is plain words with no border: a border means it can be changed. %>
<div class="ticket-facts">
  <% if (statusRow.pressable) { %>
  <details class="dropdown fact-menu status-menu" name="ticket-facts">
    <summary><span class="fact-label">Status</span> <%- include("status-badge", { status: ticket.status }) %></summary>
    <ul>
      <% for (const choice of choices) { %>
      <li>
        <% if (choice.kind === "current") { %>
        <span aria-current="true" class="menu-current"><%- include("status-badge", { status: choice.status }) %></span>
        <% } else if (choice.kind === "press") { %>
        <form method="post" action="<%= choice.action %>">
          <%- versionField %>
          <% for (const [name, value] of Object.entries(choice.fields)) { %>
          <input type="hidden" name="<%= name %>" value="<%= value %>" />
          <% } %>
          <%# Taking a ticket nobody owns is part of starting work on it, and going back to New
              leaves it with nobody, so each choice says so. %>
          <button type="submit" class="link"><span class="menu-words"><%- include("status-badge", { status: choice.status }) %><% if (choice.action.endsWith("/take-and-start")) { %> (assigns it to you)<% } else if (choice.status === "new" && ticket.owner_id) { %> (unassigns it)<% } %></span></button>
        </form>
        <% } else if (choice.kind === "resolve") { %>
        <a href="/tickets/<%= ticket.key %>?step=resolve#resolve-form"><%- include("status-badge", { status: choice.status }) %></a>
        <% } else if (choice.kind === "reopen") { %>
        <a href="/tickets/<%= ticket.key %>?step=reopen#reopen-form"><%- include("status-badge", { status: choice.status }) %></a>
        <% } else { %>
        <%# Greyed, with the reason as its title and as words for a screen reader. %>
        <button type="button" class="link" disabled <% if (statusRow.why) { %>title="<%= statusRow.why %>"<% } %>><%- include("status-badge", { status: choice.status }) %><% if (statusRow.why) { %><span class="visually-hidden">. <%= statusRow.why %></span><% } %></button>
        <% } %>
      </li>
      <% } %>
    </ul>
  </details>
  <% } else { %>
  <%# Nothing this viewer can choose: the status in plain words, with the reason as its title,
      and for a screen reader as a sentence of its own after them. %>
  <span class="fact" <% if (statusRow.why) { %>title="<%= statusRow.why %>"<% } %>><span class="fact-label">Status</span> <%- include("status-badge", { status: ticket.status }) %></span><% if (statusRow.why) { %><span class="visually-hidden"><%= statusRow.why %></span><% } %>
  <% } %>

  <% const ownerName = ticket.owner_name ?? "Unassigned"; %>
  <% const canAssignTo = allowed.handOff && handOffTo.length > 0; %>
  <% const stopAssistant = agentHelp.current && allowed.endAgentWork; %>
  <% if (allowed.take || canAssignTo || allowed.release || agentHelp.current) { %>
  <details class="dropdown fact-menu owner-menu" name="ticket-facts" <% if (problem?.form === "handOff") { %>open<% } %>>
    <summary><span class="fact-label">Owner</span> <span class="fact-value"><%= ownerName %></span></summary>
    <ul>
      <% if (allowed.take) { %>
      <li>
        <form method="post" action="/tickets/<%= ticket.key %>/take">
          <%- versionField %>
          <button type="submit" class="link">Assign to me</button>
        </form>
      </li>
      <% } %>
      <% if (canAssignTo) { %>
      <li>
        <form method="post" action="/tickets/<%= ticket.key %>/hand-off" class="assign-to">
          <input type="hidden" name="expected_owner" value="<%= ticket.owner_id ?? "" %>" />
          <%- versionField %>
          <label>
            Assign to
            <select name="to" <% if (problem?.form === "handOff") { %>aria-describedby="hand-off-error"<% } %> <%= focusIf("handOff", "to") %>>
              <% for (const member of handOffTo) { %>
              <option value="<%= member.id %>"><%= member.name %></option>
              <% } %>
            </select>
          </label>
          <% if (problem?.form === "handOff") { %><small id="hand-off-error" role="alert"><%= problem.message %></small><% } %>
          <button type="submit" class="secondary outline compact">Assign</button>
        </form>
      </li>
      <% } %>
      <% if (allowed.release) { %>
      <li>
        <form method="post" action="/tickets/<%= ticket.key %>/release">
          <%- versionField %>
          <button type="submit" class="link">Unassign</button>
        </form>
      </li>
      <% } %>
      <% if (agentHelp.current) { %>
      <li class="agent-help">Handed to <strong><%= agentHelp.current.name %></strong> (AI assistant), since <%- include("time", { iso: agentHelp.current.granted_at }) %>.</li>
      <% if (stopAssistant) { %>
      <li>
        <form method="post" action="/tickets/<%= ticket.key %>/agent/end">
          <%- versionField %>
          <button type="submit" class="link">Stop the assistant</button>
        </form>
      </li>
      <% } %>
      <% } %>
    </ul>
  </details>
  <% } else { %>
  <span class="fact"><span class="fact-label">Owner</span> <span class="fact-value"><%= ownerName %></span></span>
  <% } %>
</div>
<% } else { %>
<%# For the customer: where the ticket stands and whose turn it is, in plain words, in the small
    type of the team's line: the status mark and word, then the rest in grey. The tick takes the
    mark's place only after their own Yes. %>
<p class="ticket-standing"><% if (standing.tick) { %><img src="/assets/mark.svg" alt="" width="20" height="20" class="tick" /><span class="standing-word"><%= statusLabels[ticket.status] %></span><% } else { %><%- include("status-badge", { status: ticket.status }) %><% } %><span class="standing-rest"><%= standing.rest %><% if (standing.day) { %><time datetime="<%= standing.day %>" data-day><%= formatDay(standing.day) %></time><% } %></span></p>
<% } %>

<h2 class="visually-hidden">Description</h2>
<p class="user-text ticket-description"><%= ticket.description %></p>
<%- include("pictures", { pictures: ticketPictures, author: filerName }) %>

<% if (ticket.where_url) { %>
<p class="page-link">Page: <a href="<%= ticket.where_url %>" rel="noopener noreferrer nofollow" class="user-text"><%= ticket.where_url %></a></p>
<% } %>

<%# For the team: one other ticket that may report the same problem, and one quiet press that
    resolves this one as its duplicate. The other ticket is not changed. %>
<% if (staff && possibleDuplicate) { %>
<form method="post" action="/tickets/<%= ticket.key %>/resolve" class="possible-duplicate">
  <%- versionField %>
  <input type="hidden" name="reason" value="duplicate" />
  <input type="hidden" name="duplicate_of" value="<%= possibleDuplicate.key %>" />
  <p><span>Possible duplicate: <a href="/tickets/<%= possibleDuplicate.key %>"><%= possibleDuplicate.key %> <span class="user-text"><%= possibleDuplicate.title %></span></a></span><% if (allowed.resolveWithReason) { %> <button type="submit" class="link">Close as a duplicate of <%= possibleDuplicate.key %></button><% } %></p>
</form>
<% } %>

<%# What the customer said would prove it is fixed, where the ticket stands, and the one step this viewer
    can take: plain lines in the column, set apart by space. Once the team marks it fixed, or asks,
    the check's label becomes the customer's question, "Did this fix it?". %>
<%
  // Asked before resolving: the customer's answer settles it.
  const asking = allowed.answer;
  // Marked fixed by the team: the ticket is resolved, and the customer may say Yes or No.
  const confirming = allowed.confirmFix;
  const question = asking || confirming;
  const restoring = ticket.archived_at !== null && allowed.restore;
  // The customer's way back in, except while the question's own No does that.
  const reopening = allowed.reopen && !staff && !confirming;
  const hasStep = Boolean(locals.nextStep || locals.demoNext || restoring || reopening || stepForm);
  // While "Mark fixed and tell the customer" shows, what would prove it is fixed is said once, in
  // the sentence above that button, since the press agrees it was met. Its filer keeps it where it
  // is, beside their "Change".
  const oath = !stepForm && locals.nextStep && nextStep.oath ? nextStep.oath : null;
  const proofMoved = oath !== null && !proof.canChange;
  // Its filer's one quiet link on a ticket that does not say yet what would prove it is fixed.
  const addProof = proof.canChange && !ticket.fix_check;
  const showCard = question || ticket.fix_check || ticket.agreed_check || card.line || card.asked || hasStep || addProof || proof.waiting;
%>
<%# A code change linked to the ticket is the first line of the evidence, for the team. %>
<% const changeUrl = staff ? ticket.change_url : null; %>
<%# While an assistant's suggested test waits for a person's decision, its card sits between the
    check and the next step, so the review is read before the step that asks the customer.
    Otherwise it follows the next step. %>
<% const reviewFirst = Boolean(assistantCard && assistantCard.canDecide && assistantCard.spec && assistantCard.spec.state === "proposed"); %>
<% if (reviewFirst && !showCard) { %>
<%- include("assistant-card", { card: assistantCard, changeUrl }) %>
<% } %>
<% if (showCard) { %>
<article class="ticket-card" <% if (question) { %>id="did-this-fix-it"<% } %>>
  <% if (question) { %>
  <h2>Did this fix it?</h2>
  <% } else if (proofStep) { %>
  <%- include("proof-step", { proof, versionField }) %>
  <% } else if (ticket.fix_check && !proofMoved) { %>
  <%# Its filer may change it in the same step, from one quiet link beside its label. %>
  <p class="card-label">What would prove it is fixed?<% if (proof.canChange) { %> <a href="/tickets/<%= ticket.key %>?step=verify#verify-form" class="card-label-link" aria-label="Change what would prove it is fixed">Change</a><% } %></p>
  <% } %>
  <% if (ticket.fix_check && !proofStep && !proofMoved) { %>
  <blockquote class="user-text"><%= ticket.fix_check %></blockquote>
  <%# Just after saving, once, under the words saved. %>
  <% if (proof.saved) { %><p class="card-saved" role="status"><%= proof.saved %></p><% } %>
  <% } %>
  <% if (addProof && !proofStep) { %>
  <p class="card-proof-add"><a href="/tickets/<%= ticket.key %>?step=verify#verify-form">Add what would prove it</a></p>
  <% } %>
  <%# For the team, until the customer saves: only that suggestions wait, never the suggestions. %>
  <% if (proof.waiting) { %><p class="card-detail card-waiting"><%= proof.waiting %></p><% } %>
  <% if (ticket.agreed_check) { %>
  <p class="card-team-check"><small>Team's check: <span class="user-text"><%= ticket.agreed_check %></span></small></p>
  <% } %>

  <%# Just after asking, the line says so once, in place of where the ticket stands. %>
  <% if (card.asked) { %>
  <p class="card-line" role="status"><%= card.asked %></p>
  <% } else if (card.line) { %>
  <p class="card-line">
    <%# The only tick inside the product, always with the words "Customer confirmed". The
        customer has it once already, in the line under the title. %>
    <% if (card.line.tick && staff) { %><img src="/assets/mark.svg" alt="" width="20" height="20" class="tick" /><% } %>
    <%# The day is a <time>, so the visitor's browser writes it in their own time zone. The span
        keeps the words and the day one sentence inside the line's row. %>
    <span><%= card.line.text %><% if (card.line.day) { %><time datetime="<%= card.line.day %>" data-day><%= formatDay(card.line.day) %></time><% } %><%= card.line.after %><% if (card.line.quote) { %> "<span class="user-text"><%= card.line.quote %></span>"<% } %></span>
    <%# The customer's own message about it, when there is one: a quiet link after their line. %>
    <% if (card.lineHref) { %><a href="<%= card.lineHref %>" class="card-line-link">Read your message</a><% } %>
    <% if (card.otherHref) { %><a href="<%= card.otherHref %>">Open <%= ticket.resolution.duplicate_of %></a><% } %>
  </p>
  <% } %>

  <%# "The team says it is fixed" is said once, in the line under the title. %>
  <% if (confirming && ticket.resolution?.note) { %>
  <p class="card-detail">Fixed in: <span class="user-text"><%= ticket.resolution.note %></span></p>
  <% } %>

  <% if (asking) { %>
  <% if (ticket.try_url) { %>
  <p class="card-try">Check it here: <a href="<%= ticket.try_url %>" rel="noopener noreferrer nofollow" class="user-text"><%= ticket.try_url %></a></p>
  <% } %>
  <%# What the team gave when asking, between the check and the answer. %>
  <% if (ticket.ask) { %>
  <% if (ticket.ask.response_to_no) { %>
  <%# After the customer's No it answers that No; otherwise it is the team's message with the question. %>
  <p class="card-detail"><%= ticket.customer_answer && !ticket.customer_answer.fixed ? "What changed since you said it still fails:" : `${ticket.owner_name ?? "The team"} wrote:` %></p>
  <blockquote class="user-text"><%= ticket.ask.response_to_no %></blockquote>
  <% } %>
  <% if (ticket.ask.tried) { %>
  <p class="card-detail"><%= ticket.owner_name ?? "The team" %> tried:</p>
  <blockquote class="user-text"><%= ticket.ask.tried %></blockquote>
  <% } %>
  <% if (ticket.ask.result) { %>
  <p class="card-detail">What happened:</p>
  <blockquote class="user-text"><%= ticket.ask.result %></blockquote>
  <% } %>
  <% } %>
  <% if (evidence.length > 0) { %>
  <details class="card-evidence">
    <summary>What the team showed (<%= evidence.length %>)</summary>
    <p class="evidence-note"><small>The team reports it; Proofdesk has not checked it.</small></p>
    <%- include("evidence", { evidence }) %>
  </details>
  <% } %>
  <% } %>
  <% if (question) { %>
  <%# Yes is one press. No opens its box, and stays open with its message after a refused try.
      Asked, both answer the question; marked fixed, Yes confirms it and No reopens it. %>
  <% const noForm = asking ? "answer" : "reopen"; %>
  <% const noField = asking ? "comment" : "reason"; %>
  <div class="card-answer">
    <form method="post" action="/tickets/<%= ticket.key %>/<%= asking ? "answer" : "confirm" %>">
      <% if (asking) { %>
      <input type="hidden" name="fixed" value="yes" />
      <input type="hidden" name="ready_token" value="<%= ticket.ready_token %>" />
      <% } else { %>
      <%- versionField %>
      <% } %>
      <button type="submit">Yes, it is fixed</button>
    </form>
    <details class="answer-no" <% if (problem?.form === noForm) { %>open<% } %>>
      <summary role="button" class="secondary outline">No, it is not fixed</summary>
      <form method="post" action="/tickets/<%= ticket.key %>/<%= noForm %>">
        <% if (asking) { %>
        <input type="hidden" name="fixed" value="no" />
        <input type="hidden" name="ready_token" value="<%= ticket.ready_token %>" />
        <% } else { %>
        <%- versionField %>
        <% } %>
        <label for="answer-comment">What is still wrong?</label>
        <textarea id="answer-comment" name="<%= noField %>" rows="3" required <% if (problem?.form === noForm) { %>aria-invalid="true" aria-describedby="answer-error"<% } %> <%= focusIf(noForm, noField) %>><%= problem?.form === noForm ? problem.comment : "" %></textarea>
        <% if (problem?.form === noForm) { %><small id="answer-error"><%= problem.message %></small><% } %>
        <button type="submit" class="secondary">No, send it back</button>
      </form>
    </details>
  </div>
  <% } %>

  <% if (reviewFirst) { %>
  <%- include("assistant-card", { card: assistantCard, changeUrl }) %>
  <% } else if (assistantCard) { %>
  <%# What the assistant reported, read before the step that resolves. %>
  <%- include("assistant-reported", { key: ticket.key, reported: assistantCard.reported }) %>
  <% } %>

  <% if (resolveForm) { %>
  <% const resolving = problem?.form === "resolve" ? (problem.values ?? {}) : {}; %>
  <%# No reason is chosen at first, so a hurried press can never claim a fix. After a refused
      try, what they picked stays. %>
  <% const chosenReason = resolving.reason ?? ""; %>
  <% const reasons = Object.entries(resolveReasons); %>
  <form method="post" action="/tickets/<%= ticket.key %>/resolve" id="resolve-form" class="card-step step-form resolve">
    <%- versionField %>
    <fieldset <% if (problem?.form === "resolve") { %>aria-describedby="resolve-error"<% } %>>
      <legend>Why are you resolving this ticket?</legend>
      <% reasons.forEach(([value, label], index) => { %>
      <%# The first choice takes focus when the form opens, or the one that was chosen after a refused try. %>
      <% const focusHere = problem?.form === "resolve" ? (problem.focus === "reason" && (chosenReason ? chosenReason === value : index === 0)) : index === 0; %>
      <label><input type="radio" name="reason" value="<%= value %>" required <% if (chosenReason === value) { %>checked<% } %> <% if (focusHere) { %>autofocus<% } %> /> <%= label %></label>
      <% }) %>
    </fieldset>
    <%# The stylesheet shows each of these only for the reason that needs it. %>
    <%# Its example is never this ticket's own key. %>
    <label class="resolve-duplicate">
      Duplicate of
      <input type="text" name="duplicate_of" autocomplete="off" placeholder="A ticket key, like <%= ticket.key === "SUP-12" ? "SUP-11" : "SUP-12" %>" maxlength="20" value="<%= resolving.duplicate_of ?? possibleDuplicate?.key ?? "" %>" <%= focusIf("resolve", "duplicate_of") %> />
    </label>
    <%# One box for a note: "Why?" for Other, which needs it, and an optional note for the
        customer with Won't fix or Cannot reproduce. Only the label for the chosen reason shows. %>
    <label class="resolve-note">
      <span class="resolve-note-why">Why?</span>
      <span class="resolve-note-customer">Note for the customer (optional)</span>
      <textarea name="note" rows="2" maxlength="500" <%= focusIf("resolve", "note") %>><%= resolving.note ?? "" %></textarea>
    </label>
    <%# Fixed is the team's word that what would prove it is fixed was met, as on the next step's button. %>
    <% if (ticket.fix_check) { %><p class="resolve-fixed-in resolve-oath">By marking it fixed, you agree this is met: "<span class="user-text"><%= ticket.fix_check %></span>"</p><% } %>
    <label class="resolve-fixed-in">
      Fixed in (optional)
      <input type="text" name="fixed_in" autocomplete="off" placeholder="a version, or live now" maxlength="120" value="<%= resolving.fixed_in ?? "" %>" <%= focusIf("resolve", "fixed_in") %> />
    </label>
    <% if (problem?.form === "resolve") { %><p><small id="resolve-error" role="alert"><%= problem.message %></small></p><% } %>
    <div class="form-actions">
      <%# One label for every reason. The Fixed choice says itself that the customer is told. %>
      <button type="submit">Resolve ticket</button>
      <a href="/tickets/<%= ticket.key %>">Cancel</a>
    </div>
  </form>
  <% } else if (reopenForm) { %>
  <%# Reopening a resolved ticket needs a reason, so its choice in the Status menu opens this. %>
  <form method="post" action="/tickets/<%= ticket.key %>/reopen" id="reopen-form" class="card-step step-form">
    <%- versionField %>
    <label for="reopen-reason">Why reopen it?</label>
    <textarea id="reopen-reason" name="reason" rows="2" required <% if (problem?.form === "reopen") { %>aria-invalid="true" aria-describedby="reopen-error"<% } %> <%= problem?.form === "reopen" ? focusIf("reopen", "reason") : "autofocus" %>><%= problem?.form === "reopen" ? problem.comment : "" %></textarea>
    <% if (problem?.form === "reopen") { %><small id="reopen-error" role="alert"><%= problem.message %></small><% } %>
    <div class="form-actions">
      <button type="submit">Reopen ticket</button>
      <a href="/tickets/<%= ticket.key %>">Cancel</a>
    </div>
  </form>
  <% } else if (!proofStep) { %>
  <%# The viewer's one step: filled when it is the page's next step, outlined while an
      assistant's request for review comes first. %>
  <% if (locals.nextStep) { %>
  <div class="card-step next-action">
    <%# The press is the team's word that what would prove it is fixed was met: one grey sentence says so. %>
    <% if (oath) { %><p class="next-oath">By marking it fixed, you agree this is met: "<span class="user-text"><%= oath %></span>"</p><% } %>
    <% if (nextStep.form) { %>
    <form method="post" action="<%= nextStep.form.action %>">
      <%- versionField %>
      <% for (const [name, value] of Object.entries(nextStep.form.fields ?? {})) { %>
      <input type="hidden" name="<%= name %>" value="<%= value %>" />
      <% } %>
      <button type="submit" <% if (nextStep.outlined) { %>class="secondary"<% } %> <% if (problem?.form === "markFixed") { %>aria-describedby="mark-fixed-error"<% } %>><%= nextStep.label %></button>
    </form>
    <% } else { %>
    <a href="<%= nextStep.href %>" role="button" <% if (nextStep.outlined) { %>class="secondary"<% } %>><%= nextStep.label %></a>
    <% } %>
    <% if (nextStep.note) { %><small class="next-note"><%= nextStep.note %></small><% } %>
    <% if (problem?.form === "markFixed") { %><small id="mark-fixed-error" role="alert"><%= problem.message %></small><% } %>
  </div>
  <% } %>
  <%# On the demo: the next role to view this same ticket as. %>
  <% if (locals.demoNext) { %>
  <div class="card-step demo-next">
    <form method="post" action="/sign-in/dev">
      <input type="hidden" name="id" value="<%= demoNext.switchTo %>" />
      <input type="hidden" name="next" value="/tickets/<%= ticket.key %>" />
      <button type="submit" class="secondary outline"><%= demoNext.label %></button>
    </form>
  </div>
  <% } %>
  <% if (restoring) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/restore" class="card-step">
    <button type="submit" class="secondary">Restore ticket</button>
  </form>
  <% } %>
  <% } %>
  <%# The customer's way back in. The team reopens from the Status menu. %>
  <% if (reopening) { %>
  <details id="reopen" class="card-step" <% if (problem?.form === "reopen") { %>open<% } %>>
    <summary>Still happening?</summary>
    <form method="post" action="/tickets/<%= ticket.key %>/reopen">
      <%- versionField %>
      <label for="reopen-reason">What is happening again?</label>
      <textarea id="reopen-reason" name="reason" rows="3" required <% if (problem?.form === "reopen") { %>aria-invalid="true" aria-describedby="reopen-error"<% } %> <%= focusIf("reopen", "reason") %>><%= problem?.form === "reopen" ? problem.comment : "" %></textarea>
      <% if (problem?.form === "reopen") { %><small id="reopen-error"><%= problem.message %></small><% } %>
      <button type="submit" class="secondary compact">Still happening, reopen</button>
    </form>
  </details>
  <% } %>
</article>
<% } %>

<%# Everything an assistant left on the ticket is one card. Evidence a person attached, with no
    assistant's work beside it, is one closed line. The customer sees the proof when asked. %>
<% if (assistantCard && !reviewFirst) { %>
<%# With no card above to hold it, the reported line comes first here. %>
<% if (!showCard) { %><%- include("assistant-reported", { key: ticket.key, reported: assistantCard.reported }) %><% } %>
<%- include("assistant-card", { card: assistantCard, changeUrl }) %>
<% } else if (!assistantCard && staff && (evidence.length > 0 || changeUrl)) { %>
<details class="evidence-list">
  <summary>Evidence (<%= evidence.length + (changeUrl ? 1 : 0) %>)</summary>
  <%- include("change-line", { changeUrl }) %>
  <% if (evidence.length > 0) { %>
  <p class="evidence-note">As reported by whoever attached it. Not checked by Proofdesk.</p>
  <%- include("evidence", { evidence }) %>
  <% } %>
</details>
<% } %>

<%# The hairline where the conversation begins: above its messages, or above the message box
    when there are none yet. %>
<hr class="thread-start" />
<h2 id="conversation" class="visually-hidden">Conversation</h2>
<% for (const item of entries) { %>
<article class="entry<% if (item.kind === "note") { %> note<% } %>" id="entry-<%= item.id %>">
  <header>
    <strong><%= item.author_name %></strong><% if (item.author_kind === "agent") { %> <span class="tag">AI assistant</span><% } %>
    <small><% if (item.author_kind !== "agent") { %><%= item.author_role %> · <% } %><% if (item.kind === "note") { %><span class="note-label">internal note, the customer does not see this</span> · <% } %><%- include("time", { iso: item.created_at }) %></small>
  </header>
  <%# An assistant's long note shows its first paragraph, and the rest behind one line. A
      person's message is always whole. %>
  <% const parts = item.author_kind === "agent" && item.kind === "note" ? firstParagraph(item.body) : { first: item.body, rest: null }; %>
  <p class="user-text"><%= parts.first %></p>
  <% if (parts.rest !== null) { %>
  <details class="note-rest">
    <summary>Show the full note</summary>
    <p class="user-text"><%= parts.rest %></p>
  </details>
  <% } %>
  <%- include("pictures", { pictures: item.pictures, author: item.author_name }) %>
  <% if (item.based_on) { const source = entries.find((e) => e.id === item.based_on); if (source) { %>
  <p><small>Published from a note by <%= source.author_name %><% if (source.author_kind === "agent") { %> (AI assistant)<% } %>. Only the team sees this line.</small></p>
  <% } } %>
  <%# Only wording an assistant suggested for the customer is offered for publishing: never a
      review request or its working notes, so nothing internal reaches the customer by one click. %>
  <% if (item.kind === "note" && item.author_kind === "agent" && item.purpose === "suggested_reply" && allowed.reply && viewerRole !== "customer") { %>
  <details class="publish">
    <summary>Publish as my reply</summary>
    <form method="post" action="/tickets/<%= ticket.key %>/entries">
      <input type="hidden" name="kind" value="reply" />
      <input type="hidden" name="based_on" value="<%= item.id %>" />
      <label>
        Reply to the customer, in your name
        <textarea name="body" rows="4" required><%= item.body %></textarea>
      </label>
      <button type="submit" class="secondary compact">Send as my reply</button>
    </form>
  </details>
  <% } %>
</article>
<% } %>

<%# Just after a message was sent: the line saying so, under the message it sent, where the
    browser lands. The landing script gives it focus. %>
<% if (locals.sent) { %>
<p role="status" class="saved" id="sent"><%= sent %></p>
<% } %>

<%# The last row is two rows that never rearrange. The first is the message line alone, drawn as
    a closed text box: it is closed until wanted, and open by itself when a draft or a refused
    message is shown back. The second is History and More options; an open one shows its content
    under that row, and its own line stays where it was. %>
<div class="ticket-last-row">
<%# A message refused because this person may not send it, say after the browser's person changed
    in another tab, comes back in its box with the reason, so the typed words are not lost. %>
<% if (allowed.reply || entry.error) { %>
<details class="reply-fold" <% if (entry.body || entry.error) { %>open<% } %>>
<summary><%= allowed.note ? "Reply or add a note" : "Write a message" %></summary>
<%# Sent as multipart, since a message may carry pictures. %>
<form method="post" action="/tickets/<%= ticket.key %>/entries" class="reply-box" enctype="multipart/form-data">
  <% if (allowed.note) { %>
  <%# Who sees it: two tabs directly on top of the box. %>
  <fieldset class="kind-tabs">
    <legend class="visually-hidden">Who sees it</legend>
    <label><input type="radio" name="kind" value="reply" autocomplete="off" <% if (entry.kind !== "note") { %>checked<% } %> /> Reply to the customer</label>
    <label><input type="radio" name="kind" value="note" autocomplete="off" <% if (entry.kind === "note") { %>checked<% } %> /> Internal note</label>
  </fieldset>
  <% } else { %>
  <input type="hidden" name="kind" value="reply" />
  <% } %>
  <%# The line they pressed, or the tabs, already say what the box is for, so its label is for
      screen readers only. %>
  <label for="entry-body" class="visually-hidden">Your message</label>
  <textarea id="entry-body" name="body" rows="3" required <% if (entry.error) { %>aria-invalid="true" aria-describedby="body-error" autofocus<% } %>><%= entry.body %></textarea>
  <% if (entry.error) { %><small id="body-error"><%= entry.error %></small><% } %>
  <%# Chosen pictures show here, between the box and the send button's row. %>
  <div class="picture-strip" id="reply-picture-strip" hidden></div>
  <div class="reply-actions">
    <%# With a choice of who sees it, a small script makes the button name that audience. %>
    <%# The customer's one audience is the team, and the button says so. %>
    <button type="submit" class="secondary compact" <% if (allowed.note) { %>data-label-reply="Send reply to customer" data-label-note="Save internal note"<% } %>><%= allowed.note ? "Send" : "Send to the team" %></button>
    <%- include("add-pictures", { limit: pictureLimits.perMessage, strip: "reply-picture-strip", box: "body", line: null }) %>
    <%# Shown only while Internal note is chosen, at the row's right end. %>
    <% if (allowed.note) { %><small class="note-hint">Only the team can see this.</small><% } %>
  </div>
</form>
</details>
<% } %>

<div class="ticket-more-row">
<details class="history">
<summary>History (<%= history.length %>)</summary>
<div class="overflow-auto">
  <table>
    <thead>
      <tr>
        <th scope="col">When</th>
        <th scope="col">What</th>
        <th scope="col">Who</th>
      </tr>
    </thead>
    <tbody>
      <% for (const entry of history) { %>
      <tr>
        <td><%- include("time", { iso: entry.when }) %></td>
        <td><%= entry.what %></td>
        <td><%= entry.who %><% if (entry.role) { %> <small class="role-label"><%= entry.role %></small><% } %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
</details>

<%# Everything else this viewer may do, behind one closed line, in a fixed order. Each is one
    closed line of its own, and only one is open at a time. After a refused form inside it, it
    opens on that form and its message. %>
<% const moreForms = ["ready"]; %>
<% const giveToAgent = staff && allowed.giveToAgent && !agentHelp.current && agentHelp.candidates.length > 0; %>
<% const hasMore = allowed.edit || (staff && (allowed.markReady || allowed.withdrawQuestion)) || giveToAgent || noticeCount > 0 || allowed.archive || allowed.delete; %>
<% if (hasMore) { %>
<details class="more-options" id="more-options" <% if (moreForms.includes(problem?.form)) { %>open<% } %>>
<summary>More options</summary>
<ul class="more-list">
<% if (allowed.edit) { %>
<li><a href="/tickets/<%= ticket.key %>/edit">Edit ticket</a></li>
<% } %>
<% if (staff && allowed.markReady) { %>
<% const asked = problem?.form === "ready" ? (problem.values ?? {}) : {}; %>
<%# The old way: ask the customer and wait for their answer before resolving. Its one box is
    optional, so pressing the button with nothing typed is the plain ask. %>
<li>
<details name="more-option" class="ask-details" id="ask" <% if (problem?.form === "ready") { %>open<% } %>>
<summary>Ask before resolving</summary>
<form method="post" action="/tickets/<%= ticket.key %>/ready" class="ask">
  <%- versionField %>
  <label>
    Message to the customer (optional)
    <textarea name="response" rows="2" <% if (problem?.form === "ready") { %>aria-describedby="ready-error"<% } %> <%= focusIf("ready", "response") %>><%= asked.response ?? "" %></textarea>
  </label>
  <% if (problem?.form === "ready") { %><p><small id="ready-error" role="alert"><%= problem.message %></small></p><% } %>
  <button type="submit" class="secondary compact">Ask the customer</button>
</form>
</details>
</li>
<% } %>
<% if (staff && allowed.withdrawQuestion) { %>
<li>
<form method="post" action="/tickets/<%= ticket.key %>/withdraw-question">
  <%- versionField %>
  <button type="submit" class="link">Withdraw the question</button>
</form>
</li>
<% } %>
<% if (giveToAgent) { %>
<li>
<details name="more-option">
  <summary>Hand to an AI assistant</summary>
  <form method="post" action="/tickets/<%= ticket.key %>/agent">
    <%- versionField %>
    <label>
      Connection
      <select name="connection_id">
        <% for (const c of agentHelp.candidates) { %>
        <option value="<%= c.id %>"><%= c.name %></option>
        <% } %>
      </select>
    </label>
    <p><small>It can work on this ticket only, within what its connection allows, until you stop it, hand the ticket on, mark it fixed or ask the customer first.</small></p>
    <button type="submit" class="secondary compact">Hand to assistant</button>
  </form>
</details>
</li>
<% } %>
<% if (noticeCount > 0) { %>
<li><a href="/tickets/<%= ticket.key %>/notices">Emails sent about this ticket</a></li>
<% } %>
<% if (allowed.archive) { %>
<li><a href="/tickets/<%= ticket.key %>/archive">Archive ticket</a></li>
<% } %>
<% if (allowed.delete) { %>
<li><a href="/tickets/<%= ticket.key %>/delete" class="danger">Delete permanently</a></li>
<% } %>
</ul>
</details>
<% } %>
</div>
</div>
</div>
<%- include("footer") %>
