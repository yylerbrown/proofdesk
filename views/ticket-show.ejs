<%- include("header") %>
<p><a href="/tickets">Back to all tickets</a></p>

<hgroup>
  <h1><%= ticket.title %></h1>
  <p><%= ticket.key %>, <%= statusLabels[ticket.status] %>, filed <%= formatTime(ticket.created_at) %>, <% if (ticket.owner_name) { %>owner <%= ticket.owner_name %><% } else { %>no owner yet<% } %></p>
</hgroup>

<% if (ticket.archived_at) { %>
<article>
  <p>This ticket was archived on <%= formatTime(ticket.archived_at) %>. It is hidden from the lists and cannot be changed until it is restored.</p>
  <% if (allowed.restore) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/restore">
    <button type="submit">Restore ticket</button>
  </form>
  <% } %>
</article>
<% } %>

<h2>Description</h2>
<p class="user-text"><%= ticket.description %></p>

<% if (ticket.where_url) { %>
<h2>Where did this happen?</h2>
<p class="user-text"><a href="<%= ticket.where_url %>" rel="noopener noreferrer nofollow"><%= ticket.where_url %></a></p>
<% } %>

<% if (ticket.fix_check || ticket.agreed_check || allowed.agreeCheck) { %>
<h2>How will we know it's fixed?</h2>
<% if (ticket.agreed_check) { %>
<p><strong>Agreed check</strong></p>
<blockquote class="user-text"><%= ticket.agreed_check %></blockquote>
<p><strong>In the customer's words</strong></p>
<% } %>
<% if (ticket.fix_check) { %>
<blockquote class="user-text"><%= ticket.fix_check %></blockquote>
<% } else { %>
<p>The customer did not say.</p>
<% } %>
<% if (allowed.agreeCheck) { %>
<details>
  <summary>Agree a tighter check</summary>
  <form method="post" action="/tickets/<%= ticket.key %>/agreed-check">
    <label>
      Agreed check (leave empty to remove it)
      <textarea name="agreed_check" rows="3"><%= ticket.agreed_check ?? ticket.fix_check ?? "" %></textarea>
    </label>
    <button type="submit">Save agreed check</button>
  </form>
</details>
<% } %>
<% } %>

<% if (allowed.answer) { %>
<article>
  <h2>Did this fix it?</h2>
  <p>The team says it is fixed. Please check it<% if (ticket.try_url) { %> here: <a href="<%= ticket.try_url %>" rel="noopener noreferrer nofollow"><%= ticket.try_url %></a><% } %>.</p>
  <% const check = ticket.agreed_check ?? ticket.fix_check; %>
  <% if (check) { %>
  <p>You said we would know it is fixed when:</p>
  <blockquote class="user-text"><%= check %></blockquote>
  <% } %>
  <form method="post" action="/tickets/<%= ticket.key %>/answer">
    <input type="hidden" name="fixed" value="yes" />
    <input type="hidden" name="ready_token" value="<%= ticket.ready_token %>" />
    <button type="submit">Yes, it is fixed</button>
  </form>
  <form method="post" action="/tickets/<%= ticket.key %>/answer">
    <input type="hidden" name="fixed" value="no" />
    <input type="hidden" name="ready_token" value="<%= ticket.ready_token %>" />
    <label>
      No, it is not fixed. What is still wrong?
      <textarea name="comment" rows="3" required></textarea>
    </label>
    <button type="submit" class="secondary">No, send it back</button>
  </form>
</article>
<% } %>

<% if (ticket.change_url || ticket.ready_at || allowed.linkChange) { %>
<h2>The fix</h2>
<% if (ticket.change_url) { %>
<p>Change: <a href="<%= ticket.change_url %>" rel="noopener noreferrer nofollow" class="user-text"><%= ticket.change_url %></a></p>
<% } %>
<% if (ticket.ready_at) { %>
<p>Waiting for the customer to check it, since <%= formatTime(ticket.ready_at) %>.</p>
<% } %>
<% if (allowed.linkChange) { %>
<form method="post" action="/tickets/<%= ticket.key %>/change-link">
  <fieldset role="group">
    <input type="url" name="change_url" placeholder="Link to the code change" aria-label="Link to the code change" required />
    <button type="submit" class="secondary">Save change link</button>
  </fieldset>
</form>
<% } %>
<% if (allowed.markReady) { %>
<form method="post" action="/tickets/<%= ticket.key %>/ready">
  <fieldset role="group">
    <input type="url" name="try_url" placeholder="Page on the live site to try" aria-label="Page on the live site to try" required />
    <button type="submit">Ask the customer</button>
  </fieldset>
</form>
<% } %>
<% } %>

<% if (allowed.take || allowed.release) { %>
<h2>Owner</h2>
<div role="group">
  <% if (allowed.take) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/take">
    <button type="submit"><% if (ticket.owner_name) { %>Take over from <%= ticket.owner_name %><% } else { %>Take this ticket<% } %></button>
  </form>
  <% } %>
  <% if (allowed.release) { %>
  <form method="post" action="/tickets/<%= ticket.key %>/release">
    <button type="submit" class="secondary">Release it</button>
  </form>
  <% } %>
</div>
<% } %>

<% if (allowed.changeStatus) { %>
<h2>Status</h2>
<form method="post" action="/tickets/<%= ticket.key %>/status">
  <fieldset role="group">
    <select name="status" aria-label="Status">
      <% for (const status of statuses) { if (status === "resolved" && ticket.status !== "resolved") continue; %>
      <option value="<%= status %>" <% if (status === ticket.status) { %>selected<% } %>><%= statusLabels[status] %></option>
      <% } %>
    </select>
    <button type="submit">Change status</button>
  </fieldset>
</form>
<% } %>

<% if (allowed.edit || allowed.archive) { %>
<h2>Change this ticket</h2>
<div role="group">
  <% if (allowed.edit) { %><a href="/tickets/<%= ticket.key %>/edit" role="button" class="secondary">Edit ticket</a><% } %>
  <% if (allowed.archive) { %><a href="/tickets/<%= ticket.key %>/archive" role="button" class="secondary">Archive ticket</a><% } %>
</div>
<% } %>

<h2 id="conversation">Conversation</h2>
<% if (entries.length === 0) { %>
<p>No replies yet.</p>
<% } %>
<% for (const item of entries) { %>
<article class="entry<% if (item.kind === "note") { %> note<% } %>">
  <header>
    <strong><%= item.author_name %></strong>
    <small>(<%= item.author_role %>)<% if (item.kind === "note") { %>, internal note, the customer does not see this<% } %>, <%= formatTime(item.created_at) %></small>
  </header>
  <p class="user-text"><%= item.body %></p>
</article>
<% } %>

<% if (allowed.reply) { %>
<form method="post" action="/tickets/<%= ticket.key %>/entries">
  <% if (allowed.note) { %>
  <fieldset>
    <label><input type="radio" name="kind" value="reply" <% if (entry.kind !== "note") { %>checked<% } %> /> Reply to the customer</label>
    <label><input type="radio" name="kind" value="note" <% if (entry.kind === "note") { %>checked<% } %> /> Internal note, for the team only</label>
  </fieldset>
  <% } else { %>
  <input type="hidden" name="kind" value="reply" />
  <% } %>
  <label>
    Your message
    <textarea name="body" rows="4" required <% if (entry.error) { %>aria-invalid="true"<% } %>><%= entry.body %></textarea>
    <% if (entry.error) { %><small><%= entry.error %></small><% } %>
  </label>
  <button type="submit">Send</button>
</form>
<% } %>

<% if (allowed.delete) { %>
<p><a href="/tickets/<%= ticket.key %>/delete">Delete this ticket permanently</a></p>
<% } %>

<h2>History</h2>
<div class="overflow-auto">
  <table>
    <thead>
      <tr>
        <th>When</th>
        <th>What</th>
        <th>Who</th>
      </tr>
    </thead>
    <tbody>
      <% for (const entry of history) { %>
      <tr>
        <td><%= formatTime(entry.when) %></td>
        <td><%= entry.what %></td>
        <td><%= entry.who %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include("footer") %>
