<%- include("header") %>
<h1>Sign in</h1>

<% if (people.length === 0) { %>
<p>Sign-in is not set up on this server yet.</p>
<% } else { %>
<article>
  <p><strong>Development entrance.</strong> These people are made up. Pick one to act as. This page is only offered when the server runs with DEV_SIGN_IN=on, which it refuses to do in production.</p>
  <% for (const person of people) { %>
  <form method="post" action="/sign-in/dev">
    <input type="hidden" name="id" value="<%= person.id %>" />
    <button type="submit" class="secondary"><%= person.name %> (<%= person.role %>)</button>
  </form>
  <% } %>
</article>
<% } %>
<%- include("footer") %>
