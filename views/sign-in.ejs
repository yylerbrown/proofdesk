<%- include("header") %>
<div class="welcome">
<% if (demo) { %>
<%# On the demo this is the page about it: a visitor starts in the product, and comes here from any footer, after Sign out, or from a link to a page that needs a role. %>
<hgroup>
  <h1>About this demo</h1>
  <p>Proofdesk is a support desk where a ticket is shaped like a good prompt: the problem, the context, and what would prove it is fixed.</p>
</hgroup>

<% if (viewer) { %>
<%# Who the visitor is and how to change it, said once, with how the real site differs. %>
<p class="signed-in">You are <strong><%- include("demo-name", { person: viewer }) %></strong>, one of three made-up people. Switch with the menu at the top right.<% if (locals.realSiteUrl) { %> On <a href="<%= realSiteUrl %>">the real site</a>, people sign in with GitHub.<% if (locals.sourceUrl) { %> <a href="<%= sourceUrl %>#sign-in-and-roles">How sign-in and roles work</a><% } %><% } %></p>
<% } else if (nextTicket) { %>
<%# A link to one ticket: whose view opens it is the visitor's choice, since a customer sees only their own. %>
<p class="next-ticket" id="next-ticket">Pick a role to open <strong><%= nextTicket %></strong>.</p>
<ul class="people">
  <% for (const person of people) { %>
  <li>
    <form method="post" action="/sign-in/dev">
      <input type="hidden" name="id" value="<%= person.id %>" />
      <input type="hidden" name="next" value="<%= next %>" />
      <button type="submit" class="secondary" aria-describedby="next-ticket try-<%= person.id %>">View as <%- include("demo-name", { person }) %></button>
    </form>
    <small class="try" id="try-<%= person.id %>"><%- include("role-try", { person }) %></small>
  </li>
  <% } %>
</ul>
<% } else if (locals.walkthrough) { %>
<%# After Sign out, or a link to a page that needs a role: one button back in, as the customer. %>
<form method="post" action="/sign-in/dev" class="start-again">
  <input type="hidden" name="id" value="<%= walkthrough.id %>" />
  <input type="hidden" name="next" value="<%= next %>" />
  <button type="submit"><%= next === "/tickets" ? "Start again" : "Continue as the demo customer" %></button>
</form>
<% } %>

<section class="about-demo">
  <p>The tickets are sample data, shared with everyone who visits. Do not type anything private here. The demo resets itself when it has been quiet for a while.</p>
  <% if (!viewer) { %>
  <%# Signed out, the paragraph above has not said how roles work, so this one does. %>
  <% if (locals.realSiteUrl) { %>
  <p class="real-site">On <a href="<%= realSiteUrl %>">the real site</a>, people sign in with GitHub. Here you switch between three made-up people with the menu at the top right.<% if (locals.sourceUrl) { %> <a href="<%= sourceUrl %>#sign-in-and-roles">How sign-in and roles work</a><% } %></p>
  <% } else { %>
  <p class="roles-note">Here you switch between three made-up people with the menu at the top right.</p>
  <% } %>
  <% } %>
  <% if (viewer || locals.sourceUrl) { %>
  <p class="source-link"><% if (viewer) { %><a href="/tickets">Back to the tickets</a><% } %><% if (viewer && locals.sourceUrl) { %> · <% } %><% if (locals.sourceUrl) { %><a href="<%= sourceUrl %>#readme">Source and setup</a><% } %></p>
  <% } %>
  <%# The assistant setup is extra, so it starts folded to one quiet line. Links to /sign-in#connect
      open it without a script: a browser opens a closed details element when the address's
      #part names something inside it. %>
  <details class="connect">
    <summary>Connect your own AI assistant</summary>
    <div id="connect">
    <% if (locals.demoAgents) { %>
    <p>Get a one-day key and one message to paste into your own AI assistant, so it can work on the sample ticket made for it.</p>
    <form method="post" action="/demo/connection">
      <button type="submit" class="secondary">Get a demo connection</button>
    </form>
    <% } else { %>
    <p class="notice">Assistant connections are off on this demo until its operator resets it.</p>
    <% } %>
    </div>
  </details>
</section>
<% } else { %>
<hgroup>
  <%# The real site's sign-in says what the page is for. A signed-in visitor gets a welcome. %>
  <h1><%= github && !viewer ? "Sign in to Proofdesk" : "Proofdesk" %></h1>
  <p>Proofdesk is a support desk where a ticket is shaped like a good prompt: the problem, the context, and what would prove it is fixed.</p>
</hgroup>

<% if (viewer) { %>
<p class="signed-in">You are signed in as <strong><%= viewer.name %></strong>. <a href="/tickets">Go to the tickets</a>, or sign out at the top to switch.</p>
<% } %>

<%# Fixed text from the server. A failed sign-in is an alert; signed out is a status. %>
<% if (notice) { %>
<p class="notice sign-in-notice" role="<%= notice.alert ? "alert" : "status" %>"><%= notice.text %></p>
<% } %>

<% if (github) { %>
<% if (!viewer) { %>
<form method="post" action="/sign-in/github">
  <input type="hidden" name="next" value="<%= next %>" />
  <button type="submit" aria-describedby="github-reads"><span class="github-mark" aria-hidden="true"></span>Sign in with GitHub</button>
</form>
<% if (microsoft) { %>
<form method="post" action="/sign-in/microsoft">
  <input type="hidden" name="next" value="<%= next %>" />
  <button type="submit" aria-describedby="github-reads"><span class="microsoft-mark" aria-hidden="true"></span>Sign in with Microsoft</button>
</form>
<%# True of what the site asks each for: GitHub, email addresses (name and picture are public); Microsoft, name and email address, with no picture. %>
<p class="github-reads" id="github-reads"><small>Anyone with a GitHub account, or a Microsoft account at this organization, can sign in. Proofdesk reads your name and email address, and your picture from GitHub, never your files, mail or code.</small></p>
<% } else { %>
<%# True of the one permission the site asks GitHub for: reading email addresses. Name and picture are public. %>
<p class="github-reads" id="github-reads"><small>Anyone with a GitHub account can sign in. Proofdesk reads your name, picture and email address, never your code.</small></p>
<% } %>
<% } %>
<% if (locals.demoUrl) { %>
<p class="try-demo"><a href="<%= demoUrl %>">Try the demo without signing in</a></p>
<% } %>
<% if (locals.sourceUrl) { %>
<p class="source-link"><a href="<%= sourceUrl %>#readme">Source and setup</a></p>
<% } %>
<% } %>

<% if (!github && people.length === 0) { %>
<p>Sign-in is not set up on this server yet.</p>
<% } %>

<% if (people.length > 0) { %>
<section aria-labelledby="entrance">
  <h2 id="entrance">Development entrance</h2>
  <p>These people are made up. Pick one to act as. This is only offered when the server runs with DEV_SIGN_IN=on, which it refuses to do in production.</p>
  <% if (nextTicket) { %>
  <p class="next-ticket" id="next-ticket">Pick a person below to open <strong><%= nextTicket %></strong>.</p>
  <% } %>
  <ul class="people">
    <% for (const person of people) { %>
    <li>
      <form method="post" action="/sign-in/dev">
        <input type="hidden" name="id" value="<%= person.id %>" />
        <input type="hidden" name="next" value="<%= next %>" />
        <%# The button's description is its line below, and the ticket it opens when there is one. %>
        <button type="submit" class="secondary" aria-describedby="<%= nextTicket ? "next-ticket " : "" %>try-<%= person.id %>">View as <%- include("demo-name", { person }) %></button>
      </form>
      <small class="try" id="try-<%= person.id %>"><%- include("role-try", { person }) %></small>
    </li>
    <% } %>
  </ul>
  <p class="assistant-run-link"><a href="/assistant-run">See an assistant's work</a>: one real run on a sample ticket, with its transcript.</p>
</section>
<% } %>
<% } %>
</div>
<%- include("footer", { aboutDemo: demo }) %>
