<%- include("header") %>
<%
  // What an empty list says, for each filter. A customer is told about their own tickets.
  const mine = viewerRole === "customer";
  const empty = {
    all: mine ? "You have not filed any tickets yet." : "There are no tickets yet.",
    new: "No new tickets.",
    in_progress: "Nothing is in progress.",
    resolved: "No resolved tickets yet.",
    // On the demo nobody archives, so the Archived tab is always empty there. Say why.
    archived: viewer && viewer.demo ? "Nothing is archived. Archiving is off on this demo for everyone." : "Nothing is archived.",
  };
%>
<h1><%= mine ? "My tickets" : "All tickets" %></h1>
<p class="list-note"><small>A ticket moves from New to In Progress, and is resolved when its customer confirms the fix or the team gives a reason.</small></p>
<% if (viewer && viewer.role === "admin") { %>
<p class="role-note"><small><% if (viewer.readOnly) { %>Admin preview, read-only: you see every ticket with its history and internal notes, and nothing you do here changes them. On the real site an admin also restores archived tickets, deletes tickets permanently and manages assistant connections. Archiving, restoring and deleting are off on this demo for everyone.<% } else { %>As an admin you see every ticket with its history and internal notes, restore archived tickets, delete tickets permanently and <a href="/connections">manage assistant connections</a>.<% } %></small></p>
<% } %>
<%# The filters: by status, by owner for the team, and words to find. Each is a plain link or a GET form, and each keeps the others, so the address names the view and can be shared. %>
<div class="list-filters">
<nav aria-label="Filter by status">
  <ul>
    <li>
      <a href="<%= href({ status: "all" }) %>" <% if (current === "all") { %>aria-current="page"<% } %>>All</a>
    </li>
    <% for (const status of statuses) { %>
    <li>
      <a href="<%= href({ status }) %>" <% if (current === status) { %>aria-current="page"<% } %>><%= statusLabels[status] %> <span class="filter-count"><%= counts[status] %></span></a>
    </li>
    <% } %>
    <% if (showArchivedFilter) { %>
    <li>
      <a href="<%= href({ status: "archived" }) %>" <% if (current === "archived") { %>aria-current="page"<% } %>>Archived</a>
    </li>
    <% } %>
  </ul>
</nav>
<% if (ownerFilters) { %>
<nav aria-label="Filter by owner">
  <ul>
    <li><a href="<%= href({ owner: undefined }) %>" <% if (!filters.owner) { %>aria-current="page"<% } %>>Everyone</a></li>
    <li><a href="<%= href({ owner: "me" }) %>" <% if (filters.owner === "me") { %>aria-current="page"<% } %>>Mine</a></li>
    <li><a href="<%= href({ owner: "none" }) %>" <% if (filters.owner === "none") { %>aria-current="page"<% } %>>Unassigned</a></li>
  </ul>
</nav>
<% } %>
<form method="get" action="/tickets" role="search" class="list-search">
  <% if (current !== "all") { %><input type="hidden" name="status" value="<%= current %>" /><% } %>
  <% if (filters.owner) { %><input type="hidden" name="owner" value="<%= filters.owner %>" /><% } %>
  <% if (filters.sort !== "open_first") { %><input type="hidden" name="sort" value="<%= filters.sort.by %>" /><input type="hidden" name="direction" value="<%= filters.sort.direction %>" /><% } %>
  <input type="search" name="q" value="<%= filters.q ?? "" %>" placeholder="Search titles, descriptions or a key" aria-label="Search titles and descriptions, or open a ticket by its key" maxlength="100" />
  <button type="submit" class="secondary">Search</button>
</form>
</div>

<% if (tickets.length === 0 && narrowed) { %>
<%# Built from what is set (the owner filter, the search or both) and naming the status tab. %>
<p class="empty"><%= noMatch.sentence %> <a href="<%= href({ owner: undefined, q: undefined }) %>"><%= noMatch.clear %></a>.</p>
<% } else if (tickets.length === 0) { %>
<p class="empty"><%= empty[current] %><% if (current !== "archived") { %> <a href="/tickets/new">File a ticket</a>.<% } %></p>
<% } else { %>
<%
  // A header that sorts: a link whose name says what the next press does. The arrow repeats
  // what aria-sort on the cell says, for the eye.
  const arrow = (header) => header.ariaSort === "ascending" ? "↑" : header.ariaSort === "descending" ? "↓" : "";
  const byUpdated = filters.sort !== "open_first" && filters.sort.by === "updated";
%>
<%# On a phone the list is stacked with no header row, so the same choices sit above it there, shown by the stylesheet. %>
<nav aria-label="Sort by" class="list-sort">
  <small>Sort by:
  <% for (const header of sortHeaders) { %>
    <a href="<%= header.href %>" aria-label="<%= header.name %>" <% if (header.ariaSort) { %>aria-current="true"<% } %>><%= header.label %><% if (arrow(header)) { %> <span aria-hidden="true"><%= arrow(header) %></span><% } %></a>
  <% } %>
  </small>
</nav>
<div class="overflow-auto">
  <table class="tickets">
    <thead>
      <tr>
        <% sortHeaders.forEach((header, index) => { %>
        <% if (index === 4) { %><th scope="col">Waiting on</th><% } %>
        <th scope="col" <% if (header.ariaSort) { %>aria-sort="<%= header.ariaSort %>"<% } %>><a href="<%= header.href %>" class="sort-link" aria-label="<%= header.name %>"><%= header.label %><span class="sort-arrow" aria-hidden="true"><%= arrow(header) %></span></a></th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% for (const ticket of tickets) { %>
      <tr>
        <%# The title is the row's one keyboard stop; the key stays a link for the mouse. %>
        <td><a href="/tickets/<%= ticket.key %>" tabindex="-1"><%= ticket.key %></a></td>
        <td class="user-text title-cell" title="<%= ticket.title %>"><a href="/tickets/<%= ticket.key %>"><%= ticket.title %></a></td>
        <td><%- include("status-badge", { status: ticket.status }) %><% if (teamSaysFixed(ticket, viewerRole)) { %><small class="resolution-label">The team says it is fixed</small><small class="resolution-label">You have not confirmed it</small><% } else if (ticket.resolution) { %><small class="resolution-label"><%= ticket.resolution.by === "team" ? `By the team: ${ticket.resolution.reason_label}` : "Customer confirmed" %></small><% } %></td>
        <td><%= ticket.owner_name ?? "Unassigned" %></td>
        <td><%= ticket.waiting %></td>
        <% const when = byUpdated ? ticket.updated_at : ticket.created_at; %>
        <td><time datetime="<%= when %>" data-relative title="<%= formatTime(when) %>"><%= timeAgo(when) %></time></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% if (nextPage) { %>
<p><a href="<%= nextPage %>">Next page</a></p>
<% } %>
<% } %>
<%- include("assistant-invite", { invite }) %>
<%- include("footer") %>
