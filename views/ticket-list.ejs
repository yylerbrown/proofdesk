<%- include("header") %>
<%
  // What an empty list says, for each filter. A customer is told about their own tickets.
  const mine = viewerRole === "customer";
  const empty = {
    all: mine ? "You have not filed any tickets yet." : "There are no tickets yet.",
    open: "No open tickets.",
    new: "No new tickets.",
    in_progress: "Nothing is in progress.",
    // With one age chosen, the other age may still hold resolved tickets.
    resolved: age === "older" ? "No tickets were resolved more than 14 days ago." : age === "recent" ? "No tickets were resolved in the last 14 days." : "No resolved tickets yet.",
    // On the demo nobody archives, so the Archived tab is always empty there. Say why.
    archived: viewer && viewer.demo ? "Nothing is archived. Archiving is off on this demo for everyone." : "Nothing is archived.",
  };
%>
<% if (locals.welcome) { %><%- include("demo-welcome", { welcome }) %><% } %>
<h1><%= mine ? "My tickets" : "All tickets" %></h1>
<%# Only the read-only preview needs a word here: what it cannot do, and what a real admin can. An admin's People and Connections are in the header's person menu. %>
<% if (viewer && viewer.readOnly) { %>
<p class="role-note"><small>Read-only preview. On the real site an admin also restores archived tickets, deletes tickets permanently and manages assistant connections.</small></p>
<% } %>
<%# The list, from its filters to its last row. With scripts on, the bar for ticked tickets is moved into the dock at its top, so it lies over the filter row without moving anything and stays in view while the list scrolls. %>
<div class="list-area">
<% if (bulk && tickets.length > 0) { %><div class="bulk-dock" data-bulk-dock></div><% } %>
<%# The filters: by status, by owner for the team, and words to find. Each is a plain link or a GET form, and each keeps the others, so the address names the view and can be shared. %>
<div class="list-filters" data-list-filters>
<%# The filters together at the left, so the search box either shares their one row, at its right end, or takes a row of its own under them. %>
<div class="list-filter-groups">
<%# A lit status filter is a toggle like the owner filters: pressing it again goes back to All. %>
<nav aria-label="Filter by status">
  <ul>
    <li>
      <a href="<%= href({ status: "all" }) %>" <% if (current === "all") { %>aria-current="page"<% } %>>All</a>
    </li>
    <%# Every ticket that is not resolved: New and In Progress together. %>
    <li>
      <a href="<%= href({ status: current === "open" ? "all" : "open" }) %>" <% if (current === "open") { %>aria-current="page"<% } %>>Open <span class="filter-count"><%= counts.new + counts.in_progress %></span></a>
    </li>
    <% for (const status of statuses) { %>
    <li>
      <a href="<%= href({ status: current === status ? "all" : status }) %>" <% if (current === status) { %>aria-current="page"<% } %>><%= statusLabels[status] %> <span class="filter-count"><%= counts[status] %></span></a>
    </li>
    <% } %>
    <% if (showArchivedFilter) { %>
    <li>
      <a href="<%= href({ status: current === "archived" ? "all" : "archived" }) %>" <% if (current === "archived") { %>aria-current="page"<% } %>>Archived</a>
    </li>
    <% } %>
  </ul>
</nav>
<% if (ownerFilters) { %>
<%# Two toggles: neither is lit until pressed, and pressing the lit one clears it. They stay links, so the address names the view. %>
<nav aria-label="Filter by owner">
  <ul>
    <% for (const [owner, label] of [["me", "Mine"], ["none", "Unassigned"]]) { %>
    <li><a href="<%= href({ owner: filters.owner === owner ? undefined : owner }) %>" <% if (filters.owner === owner) { %>aria-current="page"<% } %>><%= label %></a></li>
    <% } %>
  </ul>
</nav>
<% } %>
<% if (ageFilter) { %>
<%# On "Resolved" with nothing searched: which resolved tickets it shows. Any age is the default and writes nothing in the address. %>
<nav aria-label="Resolved tickets by age">
  <ul>
    <% for (const [choice, label] of [["any", "Any age"], ["recent", "Last 14 days"], ["older", "Older"]]) { %>
    <li><a href="<%= href({ resolved: choice === "any" ? undefined : choice }) %>" <% if (age === choice) { %>aria-current="page"<% } %>><%= label %><% if (choice === "older") { %> <span class="filter-count"><%= ageFilter.olderCount %></span><% } %></a></li>
    <% } %>
  </ul>
</nav>
<% } %>
</div>
<form method="get" action="/tickets" role="search" class="list-search">
  <% if (current !== "all") { %><input type="hidden" name="status" value="<%= current %>" /><% } %>
  <% if (filters.owner) { %><input type="hidden" name="owner" value="<%= filters.owner %>" /><% } %>
  <% if (filters.sort !== "open_first") { %><input type="hidden" name="sort" value="<%= filters.sort.by %>" /><input type="hidden" name="direction" value="<%= filters.sort.direction %>" /><% } %>
  <%# One box and no button: pressing Enter sends a form with one text box. %>
  <input type="search" name="q" autocomplete="off" value="<%= filters.q ?? "" %>" placeholder="Search words or a key, then press Enter" aria-label="Search titles, descriptions and ticket keys" maxlength="100" />
</form>
</div>

<% if (tickets.length === 0 && narrowed) { %>
<%# Built from what is set (the owner filter, the search or both) and naming the status tab. %>
<p class="empty"><%= noMatch.sentence %> <a href="<%= href({ owner: undefined, q: undefined }) %>"><%= noMatch.clear %></a>.</p>
<% } else if (tickets.length === 0) { %>
<p class="empty"><%= empty[current] %><% if (current !== "archived") { %> <a href="/tickets/new">File a ticket</a>.<% } %></p>
<% } else { %>
<%
  // A header that sorts: a link whose name says what the next press does. The arrow repeats
  // what aria-sort on the cell says, for the eye.
  const arrow = (header) => header.ariaSort === "ascending" ? "↑" : header.ariaSort === "descending" ? "↓" : "";
  const byUpdated = filters.sort !== "open_first" && filters.sort.by === "updated";
%>
<%# On a phone the list is stacked with no header row, so the same choices sit above it there, shown by the stylesheet. %>
<nav aria-label="Sort by" class="list-sort">
  <small>Sort by:
  <% for (const header of sortHeaders) { %>
    <a href="<%= header.href %>" aria-label="<%= header.name %>" <% if (header.ariaSort) { %>aria-current="true"<% } %>><%= header.label %><% if (arrow(header)) { %> <span aria-hidden="true"><%= arrow(header) %></span><% } %></a>
  <% } %>
  </small>
</nav>
<% if (bulk) { %>
<%# The team ticks tickets, then changes them together: one form, so it works without scripts.
    Without scripts the bar sits here, above the table, always shown. With scripts it lies over
    the filter row only while something is ticked, so ticking a row moves nothing. Its controls
    name the form, so they still send it from there. %>
<form method="post" action="<%= bulk.action %>" class="bulk" id="bulk-form" data-bulk>
<div class="bulk-bar" role="group" aria-labelledby="bulk-count" data-bulk-bar>
  <p id="bulk-count" class="bulk-count" aria-live="polite" data-bulk-count>Change the ticked tickets:</p>
  <%# Each choice names itself in its first option, so the bar needs no labels above them. %>
  <select name="status" aria-label="Status" form="bulk-form">
    <option value="">Set status</option>
    <% for (const status of statuses) { %><option value="<%= status %>" <% if (bulk.values.status === status) { %>selected<% } %>><%= statusLabels[status] %></option><% } %>
  </select>
  <%# The stylesheet shows the reason only for Resolved, right after the status. Only reasons that need no more words are offered, so the bar never holds a text box. %>
  <select name="reason" aria-label="Reason" class="bulk-reason" form="bulk-form">
    <option value="">Reason</option>
    <% for (const [value, label] of Object.entries(bulk.resolveReasons)) { %><option value="<%= value %>" <% if (bulk.values.reason === value) { %>selected<% } %>><%= label %></option><% } %>
  </select>
  <select name="owner" aria-label="Assign to" form="bulk-form">
    <option value="">Assign to</option>
    <option value="me" <% if (bulk.values.owner === "me") { %>selected<% } %>>Me</option>
    <% for (const member of bulk.members) { %><option value="<%= member.id %>" <% if (bulk.values.owner === member.id) { %>selected<% } %>><%= member.name %></option><% } %>
    <option value="nobody" <% if (bulk.values.owner === "nobody") { %>selected<% } %>>Unassigned</option>
  </select>
  <button type="submit" class="compact" form="bulk-form">Apply</button>
  <%# Shown by the script, which unticks every row. %>
  <button type="button" class="link bulk-clear" hidden data-bulk-clear>Clear</button>
  <% if (bulk.message) { %><p class="bulk-error" role="alert" data-bulk-error><small><%= bulk.message %></small></p><% } %>
</div>
<p class="bulk-all-phone" hidden data-bulk-phone><label><input type="checkbox" class="bulk-tick" data-bulk-all /> <%= pages ? "Tick all on this page" : "Tick all shown" %></label></p>
<% } %>
<div class="overflow-auto">
  <table class="tickets">
    <thead>
      <tr>
        <% sortHeaders.forEach((header, index) => { %>
        <%# The plain name stands in for the link on a phone, where the header row is not drawn, so no keyboard stop hides there. %>
        <th scope="col" <% if (header.ariaSort) { %>aria-sort="<%= header.ariaSort %>"<% } %>><% if (bulk && index === 0) { %><input type="checkbox" class="bulk-tick" <% if (pages) { %>aria-label="Tick all on this page" title="Tick all on this page"<% } else { %>aria-label="Tick every ticket shown"<% } %> hidden data-bulk-all /><% } %><a href="<%= header.href %>" class="sort-link" aria-label="<%= header.name %>"><%= header.label %><span class="sort-arrow" aria-hidden="true"><%= arrow(header) %></span></a><span class="sort-label"><%= header.label %></span></th>
        <%# Right after Status, a narrow column that sorts nothing: the ticket's proof mark. %>
        <% if (header.column === "status") { %><th scope="col" class="proof-cell">Proof</th><% } %>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% for (const ticket of tickets) { %>
      <tr>
        <%# The title is the row's one link and keyboard stop, and the whole row opens it. The key
            is plain text, so nothing that looks pressable is skipped by the keyboard. %>
        <td><% if (bulk) { %><input type="checkbox" class="bulk-tick" name="keys" value="<%= ticket.key %>" aria-label="Tick <%= ticket.key %>" <% if (bulk.ticked.has(ticket.key)) { %>checked<% } %> /><% } %><span class="ticket-key"><%= ticket.key %></span></td>
        <td class="user-text title-cell" title="<%= ticket.title %>"><a href="/tickets/<%= ticket.key %>"><%= ticket.title %></a></td>
        <%# One line: the status word, and a quiet tag only when it is not simply the team's turn. How the team resolved a ticket is on its own page. %>
        <td class="status-cell"><%- include("status-badge", { status: ticket.status }) %><% if (ticket.tagHref) { %> <a class="turn-tag" href="<%= ticket.tagHref %>"><%= ticket.tag %></a><% } else if (ticket.tag) { %> <span class="turn-tag"><%= ticket.tag %></span><% } %></td>
        <td class="proof-cell"><%- include("proof-mark", { ticket }) %></td>
        <td><%= ticket.owner_name ?? "Unassigned" %></td>
        <% const when = byUpdated ? ticket.updated_at : ticket.created_at; %>
        <td><time datetime="<%= when %>" data-relative title="<%= formatTime(when) %>"><%= timeAgo(when) %></time></td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% if (bulk) { %></form><% } %>
<%# A list of more than one page: one quiet line of plain links that keep the filters, search and sort. %>
<% if (pages) { %>
<nav aria-label="Pages" class="list-pages">
  <% if (pages.previous) { %><a href="<%= pages.previous %>">Previous page</a><% } %>
  <span>Page <%= pages.page %> of <%= pages.last %></span>
  <% if (pages.next) { %><a href="<%= pages.next %>">Next page</a><% } %>
</nav>
<% } %>
<%# What the Proof column's two marks mean, once a row shows one: the marks drawn as in the column, with their words. A phone's list has no header row, so this is where it says so. %>
<% if (tickets.some((t) => (t.resolution && t.resolution.by === "customer") || t.fix_check)) { %>
<%# Each mark stays on one line with its words, so a narrow screen breaks only between the two. %>
<p class="proof-legend"><small><span class="legend-item"><span class="proof-mark proof-said" aria-hidden="true"></span> Says what would prove it is fixed</span> <span class="legend-item"><span class="proof-mark confirmed-mark" aria-hidden="true"></span> Customer confirmed</span></small></p>
<% } %>
<% } %>
</div>
<%- include("assistant-invite", { invite }) %>
<%- include("footer") %>
